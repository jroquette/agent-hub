[importlinter]
# The single namespace root; contracts name its subpackages (ADR 0001).
root_packages =
    agent_hub
# Lets contracts name third-party packages (core must not use the adapter libraries).
include_external_packages = True

[importlinter:contract:core-independent]
name = core imports nothing internal
type = forbidden
source_modules =
    agent_hub.core
# Sibling packages, and the adapter libraries (core stays Pydantic-only, ADR 0002).
forbidden_modules =
    agent_hub.storage
    agent_hub.collector
    agent_hub.generator
    agent_hub.tracker_linear
    agent_hub.hub_git
    agent_hub.claude_sessions
    agent_hub.cli
    agent_hub.api
    sqlalchemy
    alembic
    typer
    fastapi
    starlette
    uvicorn
    yaml

# cli is the composition root (ADR 0008): it may import the adapters to wire them into core use cases, nothing
# imports it, and the adapters below it stay independent of each other ("|"). api (Phase 2) is a second
# composition root, one layer down: it wires the adapters for the web server and never imports cli.
[importlinter:contract:composition-root]
name = cli is the composition root
type = layers
layers =
    agent_hub.cli
    agent_hub.api
    agent_hub.storage | agent_hub.collector | agent_hub.generator | agent_hub.tracker_linear | agent_hub.hub_git | agent_hub.claude_sessions

# `hub web` is the one command that starts the API server; every other cli module stays free of it.
[importlinter:contract:cli-api-web-command]
name = cli reaches api only through web_command
type = forbidden
source_modules =
    agent_hub.cli
forbidden_modules =
    agent_hub.api
ignore_imports =
    agent_hub.cli.web_command -> agent_hub.api
    agent_hub.cli.web_command -> agent_hub.api.**
# web_command may import the package or its modules, so one of the two lines can stay unmatched.
unmatched_ignore_imports_alerting = none

# The Claude Agent SDK stays inside the claude_sessions adapter (ADR 0031): api wires that adapter, and
# no other package, api and cli included, imports the SDK itself.
[importlinter:contract:claude-agent-sdk-confined]
name = only claude_sessions imports the Claude Agent SDK
type = forbidden
source_modules =
    agent_hub.core
    agent_hub.storage
    agent_hub.collector
    agent_hub.generator
    agent_hub.tracker_linear
    agent_hub.hub_git
    agent_hub.cli
    agent_hub.api
forbidden_modules =
    claude_agent_sdk
# api reaches the SDK only through claude_sessions (composition's guarded import): indirect imports pass.
allow_indirect_imports = True

# Driving sessions belongs to hub web (api); every cli module stays free of the session adapter.
[importlinter:contract:cli-no-claude-sessions]
name = cli never imports claude_sessions
type = forbidden
source_modules =
    agent_hub.cli
forbidden_modules =
    agent_hub.claude_sessions
# web_command reaches it only through api's composition.
allow_indirect_imports = True
