{
  "version": 1,
  "kind": "scenario",
  "name": "b2b-credit-order",
  "revision": 1,
  "description": "One B2B credit order on a personal stack, from fetch to a settled cover",
  "inputs": {
    "webshop_order_id": {
      "required": true,
      "description": "The order to follow, from the webshop"
    },
    "webshop_id": {
      "default": "ws-0001"
    },
    "brand_id": {
      "default": "brand-0001"
    },
    "fetch_timedelta_minutes": {
      "type": "integer",
      "default": 60
    },
    "personal_name": {
      "required": true,
      "description": "From the environment's values"
    },
    "aws_account_id": {
      "required": true,
      "description": "From the environment's values"
    }
  },
  "nodes": [
    {
      "id": "fetch-order-1",
      "type": "action",
      "action": "queue-send",
      "with": {
        "message": "FETCH_ORDERS"
      }
    },
    {
      "id": "fetch-order-2",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "fetch-order-1"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.order_status == 'ON_HOLD' && $self.output.cover_status == 'PENDING'",
      "capture": {
        "order_id": "$self.output.order_id"
      }
    },
    {
      "id": "quote-1",
      "type": "action",
      "action": "queue-send",
      "depends_on": [
        "fetch-order-2"
      ],
      "with": {
        "message": "INSURANCE_RESOLVE_COVER_JOBS",
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "quote-2",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "quote-1"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.cover_status == 'QUOTED' && $self.output.payment_status == 'CREDIT_CONFIRMED' && $self.output.open_tasks > 0"
    },
    {
      "id": "switch-to-fedex-1",
      "type": "action",
      "action": "order-set-fedex",
      "depends_on": [
        "quote-2"
      ],
      "with": {
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "switch-to-fedex-2",
      "type": "action",
      "action": "order-tasks-resolve",
      "depends_on": [
        "switch-to-fedex-1"
      ],
      "with": {
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "switch-to-fedex-3",
      "type": "action",
      "action": "shipments-regenerate",
      "depends_on": [
        "switch-to-fedex-2"
      ],
      "with": {
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "switch-to-fedex-4",
      "type": "action",
      "action": "queue-send",
      "depends_on": [
        "switch-to-fedex-3"
      ],
      "with": {
        "message": "order-process",
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "switch-to-fedex-5",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "switch-to-fedex-4"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.order_status == 'PROCESSING_COMPLETED'"
    },
    {
      "id": "dispatch-1",
      "type": "action",
      "action": "shipments-mark-in-transit",
      "depends_on": [
        "switch-to-fedex-5"
      ],
      "with": {
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "dispatch-2",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "dispatch-1"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.invoice_status == 'CREATED'",
      "capture": {
        "invoice_number": "$self.output.invoice_number"
      }
    },
    {
      "id": "invoice-pdf-1",
      "type": "approval",
      "message": "Render the PDF of invoice $CTX.invoice_number by hand, then approve.",
      "depends_on": [
        "dispatch-2"
      ]
    },
    {
      "id": "send-invoice-1",
      "type": "action",
      "action": "queue-send",
      "depends_on": [
        "invoice-pdf-1"
      ],
      "with": {
        "message": "GENERATE_WEBSHOP_INVOICE",
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "send-invoice-2",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "send-invoice-1"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.invoice_status == 'CREATED_ON_PLATFORM' && $self.output.invoice_update_job_id != ''"
    },
    {
      "id": "activation-1",
      "type": "action",
      "action": "queue-send",
      "depends_on": [
        "send-invoice-2"
      ],
      "with": {
        "message": "poller",
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "activation-2",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "activation-1"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.activation_job_id != ''"
    },
    {
      "id": "activation-3",
      "type": "action",
      "action": "queue-send",
      "depends_on": [
        "activation-2"
      ],
      "with": {
        "message": "poller",
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "activation-4",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "activation-3"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.cover_status == 'ACTIVATED'"
    },
    {
      "id": "payment-1",
      "type": "approval",
      "message": "Pay order $CTX.order_id in Stripe test mode, then approve.",
      "depends_on": [
        "activation-4"
      ]
    },
    {
      "id": "payment-2",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "payment-1"
      ],
      "every": "15s",
      "timeout": "15m",
      "until_when": "$self.output.paid == true && $self.output.payment_job_id != ''"
    },
    {
      "id": "payment-3",
      "type": "action",
      "action": "queue-send",
      "depends_on": [
        "payment-2"
      ],
      "with": {
        "message": "poller",
        "order_id": "$CTX.order_id"
      }
    },
    {
      "id": "payment-4",
      "type": "expect",
      "action": "order-state",
      "depends_on": [
        "payment-3"
      ],
      "every": "15s",
      "timeout": "10m",
      "until_when": "$self.output.cover_status == 'SETTLED'"
    }
  ]
}
