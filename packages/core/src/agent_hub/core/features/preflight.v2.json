{
  "$defs": {
    "Commit": {
      "pattern": "^[0-9a-f]{7,40}$",
      "type": "string"
    },
    "GateText": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "OneLine1000": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "PreflightRunV2": {
      "additionalProperties": false,
      "description": "One preflight run of a ticket, as schema 1's, with main's commit in each repo the ticket\nowns when it owns several (``commits``, in contract order, the first repo's also ``commit``),\nelse null.",
      "properties": {
        "ran_at": {
          "format": "date-time",
          "title": "Ran At",
          "type": "string"
        },
        "plan_version": {
          "minimum": 1,
          "title": "Plan Version",
          "type": "integer"
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        },
        "blockers_read": {
          "items": {
            "$ref": "#/$defs/TicketKey"
          },
          "maxItems": 50,
          "title": "Blockers Read",
          "type": "array"
        },
        "input": {
          "enum": [
            "none",
            "discovery",
            "declined_change"
          ],
          "title": "Input",
          "type": "string"
        },
        "input_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/OneLine1000"
            },
            {
              "type": "null"
            }
          ]
        },
        "drift": {
          "enum": [
            "none",
            "local",
            "plan"
          ],
          "title": "Drift",
          "type": "string"
        },
        "local_notes": {
          "items": {
            "$ref": "#/$defs/OneLine1000"
          },
          "maxItems": 50,
          "title": "Local Notes",
          "type": "array"
        },
        "change_request": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Change Request"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "commits": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RepoMainCommit"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commits"
        }
      },
      "required": [
        "ran_at",
        "plan_version",
        "commit",
        "blockers_read",
        "input",
        "input_text",
        "drift",
        "local_notes",
        "change_request",
        "run_id",
        "commits"
      ],
      "title": "PreflightRunV2",
      "type": "object"
    },
    "RepoMainCommit": {
      "additionalProperties": false,
      "description": "One repo of a ticket that owns several: main's commit there that a preflight run read.",
      "properties": {
        "repo": {
          "$ref": "#/$defs/GateText"
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        }
      },
      "required": [
        "repo",
        "commit"
      ],
      "title": "RepoMainCommit",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "TicketKey": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Every preflight run of one ticket that owns several repos, oldest first; runs are only\never appended, a run before the ticket owned several naming no ``commits``.",
  "properties": {
    "schema": {
      "const": "agent-hub/preflight/2",
      "title": "Schema",
      "type": "string"
    },
    "ticket": {
      "$ref": "#/$defs/TicketKey"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/PreflightRunV2"
      },
      "maxItems": 200,
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ticket",
    "runs"
  ],
  "title": "PreflightRecordV2",
  "type": "object"
}
