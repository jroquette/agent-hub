{
  "$defs": {
    "BrainLeakSettings": {
      "additionalProperties": false,
      "description": "``brain.leak``: the shortest trimmed brain line that counts as a leak.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "min_line_length": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "type": "integer"
        }
      },
      "title": "BrainLeakSettings",
      "type": "object"
    },
    "ContractSyncSettings": {
      "additionalProperties": false,
      "description": "``contract-sync``: the repo that exports the contract and the repo that imports it.\n\nBoth are ``repos[].dir`` entries, checked by ``HubConfig``, which knows the repos.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "source": {
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "ContractSyncSettings",
      "type": "object"
    },
    "Conventions": {
      "additionalProperties": false,
      "description": "Branch and title patterns; each absent key keeps today's shape.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "branch": {
          "description": "Branch pattern: {prefix}, {ISSUE}, {issue_lower}, {slug}; needs {ISSUE} or {issue_lower}. Default {prefix}{issue_lower}-{slug}.",
          "type": "string"
        },
        "commit_title": {
          "description": "Commit title pattern: {ISSUE}, {type}, {scope}, {summary}; needs {summary}. Default {type}({scope}): {summary} ({ISSUE}).",
          "type": "string"
        },
        "pr_title": {
          "description": "PR title pattern: {ISSUE}, {type}, {scope}, {summary}; needs {summary}. Default: the effective commit_title.",
          "type": "string"
        }
      },
      "title": "Conventions",
      "type": "object"
    },
    "Doctor": {
      "additionalProperties": false,
      "description": "How ``hub doctor`` is tuned for this project (docs/design/hub-doctor.md).",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "rules": {
          "$ref": "#/$defs/DoctorRules"
        }
      },
      "title": "Doctor",
      "type": "object"
    },
    "DoctorRules": {
      "additionalProperties": false,
      "description": "``doctor.rules``: one optional entry per rule id, except ``config.schema``.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "platform.version": {
          "$ref": "#/$defs/RuleSettings"
        },
        "lock.drift": {
          "$ref": "#/$defs/RuleSettings"
        },
        "links.dead": {
          "$ref": "#/$defs/RuleSettings"
        },
        "instructions.size": {
          "$ref": "#/$defs/InstructionsSizeSettings"
        },
        "instructions.refs": {
          "$ref": "#/$defs/RuleSettings"
        },
        "instructions.duplicates": {
          "$ref": "#/$defs/RuleSettings"
        },
        "rules.frontmatter": {
          "$ref": "#/$defs/RuleSettings"
        },
        "settings.valid": {
          "$ref": "#/$defs/RuleSettings"
        },
        "settings.weakening": {
          "$ref": "#/$defs/RuleSettings"
        },
        "permissions.bypass": {
          "$ref": "#/$defs/RuleSettings"
        },
        "secrets.config": {
          "$ref": "#/$defs/RuleSettings"
        },
        "mcp.pinned": {
          "$ref": "#/$defs/RuleSettings"
        },
        "attribution.ai": {
          "$ref": "#/$defs/RuleSettings"
        },
        "brain.leak": {
          "$ref": "#/$defs/BrainLeakSettings"
        },
        "hooks.guard-extension": {
          "$ref": "#/$defs/RuleSettings"
        },
        "makefile.override": {
          "$ref": "#/$defs/RuleSettings"
        },
        "features.tracker": {
          "$ref": "#/$defs/RuleSettings"
        },
        "bench.tasks": {
          "$ref": "#/$defs/RuleSettings"
        },
        "config.identity": {
          "$ref": "#/$defs/IdentityRuleSettings"
        },
        "config.stop_gate": {
          "$ref": "#/$defs/StopGateRuleSettings"
        }
      },
      "title": "DoctorRules",
      "type": "object"
    },
    "Guard": {
      "additionalProperties": false,
      "description": "Paths and hosts the hub's guard hook asks about or denies.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "ask_before_edit": {
          "default": [],
          "items": {
            "pattern": "^(?:[!-.0-\\[\\]-~]*[!-\\-0-\\[\\]-~][!-.0-\\[\\]-~]*|\\.{3,})(?:/(?:[!-.0-\\[\\]-~]*[!-\\-0-\\[\\]-~][!-.0-\\[\\]-~]*|\\.{3,}))*$",
            "type": "string"
          },
          "title": "Ask Before Edit",
          "type": "array"
        },
        "deny_hosts": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*$",
            "type": "string"
          },
          "title": "Deny Hosts",
          "type": "array"
        },
        "deny_paths": {
          "default": [],
          "items": {
            "pattern": "^(?:[!-.0-\\[\\]-~]*[!-\\-0-\\[\\]-~][!-.0-\\[\\]-~]*|\\.{3,})(?:/(?:[!-.0-\\[\\]-~]*[!-\\-0-\\[\\]-~][!-.0-\\[\\]-~]*|\\.{3,}))*$",
            "type": "string"
          },
          "title": "Deny Paths",
          "type": "array"
        }
      },
      "title": "Guard",
      "type": "object"
    },
    "IdentityRuleSettings": {
      "additionalProperties": false,
      "description": "``config.identity``: whether it runs. It has no ``severity``: its finding stays an info,\nso a hub gives every developer the same exit code.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "IdentityRuleSettings",
      "type": "object"
    },
    "InstructionsSizeSettings": {
      "additionalProperties": false,
      "description": "``instructions.size``: the line limits of instruction files.\n\n``max_lines`` stays a plain ``dict``, so frozen is shallow for the ``max_lines`` map.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "max_lines": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "maxProperties": 256,
          "patternProperties": {
            "^_": {}
          },
          "propertyNames": {
            "maxLength": 1024,
            "minLength": 1
          },
          "type": "object"
        }
      },
      "title": "InstructionsSizeSettings",
      "type": "object"
    },
    "ModuleSettings": {
      "additionalProperties": false,
      "description": "The settings of a module that takes none: only ``{}`` (and ``_`` keys).",
      "patternProperties": {
        "^_": {}
      },
      "properties": {},
      "title": "ModuleSettings",
      "type": "object"
    },
    "Modules": {
      "additionalProperties": false,
      "description": "The optional modules this hub selects: a key present means the module is selected.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "cloud": {
          "$ref": "#/$defs/ModuleSettings"
        },
        "bench": {
          "$ref": "#/$defs/ModuleSettings"
        },
        "contract-sync": {
          "$ref": "#/$defs/ContractSyncSettings"
        },
        "marketplace": {
          "$ref": "#/$defs/ModuleSettings"
        }
      },
      "title": "Modules",
      "type": "object"
    },
    "Platform": {
      "additionalProperties": false,
      "description": "The platform release this hub is pinned to.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "repository": {
          "description": "The platform's git source: the repository root as git+https://<host>/<path>, at most 200 characters. The hub runs <repository>@v<platform.version>#subdirectory=packages/agent-hub. Absent: the agent-hub release repository (docs/design/project-config.md).",
          "maxLength": 200,
          "pattern": "^git\\+https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?:/[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*)+$",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "Platform",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "description": "Project identity, authorship and branch rules.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "hub_repo": {
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*/[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*$",
          "title": "Hub Repo",
          "type": "string"
        },
        "branch_prefix": {
          "description": "Per developer: hub.local.json, else this, else the effective author email's local part plus / (docs/design/developer-identity.md).",
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*/$",
          "type": "string"
        },
        "default_branch": {
          "default": "main",
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*(?:/[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*)*$",
          "title": "Default Branch",
          "type": "string"
        },
        "author_name": {
          "description": "Per developer: hub.local.json, else this, else git config (docs/design/developer-identity.md).",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "author_email": {
          "description": "Per developer: hub.local.json, else this, else git config (docs/design/developer-identity.md).",
          "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$",
          "type": "string"
        },
        "conventions": {
          "$ref": "#/$defs/Conventions",
          "description": "Branch and title patterns for every repo; absent keys keep today's shapes."
        }
      },
      "required": [
        "name",
        "hub_repo"
      ],
      "title": "Project",
      "type": "object"
    },
    "Repo": {
      "additionalProperties": false,
      "description": "A repo managed by the hub, checked out next to it.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "dir": {
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*$",
          "title": "Dir",
          "type": "string"
        },
        "github": {
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*/[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*$",
          "title": "Github",
          "type": "string"
        },
        "role": {
          "default": "app",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Role",
          "type": "string"
        },
        "check_fast": {
          "description": "The fast gate the Stop hook runs. Absent, empty or blank: no Stop gate.",
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        "check_fast_timeout": {
          "description": "Seconds the Stop hook gives check_fast, within its 160 s budget. Absent: 150.",
          "maximum": 160,
          "minimum": 1,
          "type": "integer"
        },
        "check": {
          "pattern": "^[^\\x00-\\x1f\\x7f]*[^\\x00-\\x1f\\x7f\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000][^\\x00-\\x1f\\x7f]*$",
          "title": "Check",
          "type": "string"
        },
        "default_branch": {
          "description": "The repo's default branch: worktree and PR base, push guard. Absent: project.default_branch.",
          "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*(?:/[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*)*$",
          "type": "string"
        },
        "conventions": {
          "$ref": "#/$defs/Conventions",
          "description": "Overrides project.conventions key by key."
        }
      },
      "required": [
        "dir",
        "github",
        "check"
      ],
      "title": "Repo",
      "type": "object"
    },
    "RuleSettings": {
      "additionalProperties": false,
      "description": "How a project tunes one rule: whether it runs, and the level of its findings.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "title": "RuleSettings",
      "type": "object"
    },
    "Severity": {
      "description": "The level of a finding.",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StopGateRuleSettings": {
      "additionalProperties": false,
      "description": "``config.stop_gate``: whether it runs. It has no ``severity``: a repo without a Stop gate\nstays a warning, never an error that fails the hub's checks on its own.",
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "StopGateRuleSettings",
      "type": "object"
    },
    "Tracker": {
      "additionalProperties": false,
      "description": "The task tracker, how the CLI reaches it and the labels the runner uses.",
      "oneOf": [
        {
          "required": [
            "team"
          ]
        },
        {
          "required": [
            "teams"
          ]
        }
      ],
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "kind": {
          "const": "linear",
          "title": "Kind",
          "type": "string"
        },
        "team": {
          "description": "The tracker's team key. Never with tracker.teams.",
          "pattern": "^[A-Za-z0-9]+$",
          "type": "string"
        },
        "teams": {
          "description": "Several team keys, the first being the default. Never with tracker.team.",
          "items": {
            "pattern": "^[A-Za-z0-9]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "transport": {
          "default": "api",
          "enum": [
            "api",
            "mcp"
          ],
          "title": "Transport",
          "type": "string"
        },
        "ready_label": {
          "default": "agent-ready",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Ready Label",
          "type": "string"
        },
        "failed_label": {
          "default": "agent-failed",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Failed Label",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Tracker",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The whole ``hub.json``; the CLI and ``hub doctor`` validate with it.",
  "patternProperties": {
    "^_": {}
  },
  "properties": {
    "$schema": {
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "platform": {
      "$ref": "#/$defs/Platform"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "tracker": {
      "$ref": "#/$defs/Tracker"
    },
    "repos": {
      "items": {
        "$ref": "#/$defs/Repo"
      },
      "minItems": 1,
      "title": "Repos",
      "type": "array"
    },
    "guard": {
      "$ref": "#/$defs/Guard",
      "default": {
        "ask_before_edit": [],
        "deny_hosts": [],
        "deny_paths": []
      }
    },
    "modules": {
      "$ref": "#/$defs/Modules"
    },
    "doctor": {
      "$ref": "#/$defs/Doctor"
    }
  },
  "required": [
    "schema_version",
    "platform",
    "project",
    "tracker",
    "repos"
  ],
  "title": "hub.json",
  "type": "object"
}
