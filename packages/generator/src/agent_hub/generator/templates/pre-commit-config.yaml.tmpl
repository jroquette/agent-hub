# Hygiene hooks from a pinned release tag, then hub doctor through ./hub, the release pinned in
# hub.json (platform.version, read when the hook runs). Managed by hub sync.
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-json
      - id: check-yaml
  - repo: local
    hooks:
      - id: hub-doctor
        name: hub doctor
        language: system
        entry: ./hub doctor
        pass_filenames: false
        always_run: true
