# Hygiene hooks from a pinned release tag, then hub doctor through ./hub, the release pinned in
# hub.json (platform.version, read when the hook runs). At git's commit-msg stage, commit_msg.py
# refuses AI attribution in the message and, when hub.json names project.author_email, another
# author or committer (AGENTS.md rule 1). `pre-commit install` installs both hook types; every
# other hook runs at the pre-commit stage only. Managed by hub sync.
default_install_hook_types: [pre-commit, commit-msg]
default_stages: [pre-commit]
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-json
      - id: check-yaml
  - repo: local
    hooks:
      - id: hub-doctor
        name: hub doctor
        language: system
        entry: ./hub doctor
        pass_filenames: false
        always_run: true
      - id: commit-msg
        name: commit message and author (AGENTS.md rule 1)
        language: system
        entry: python3 plugin/hub-workflow/hooks/commit_msg.py
        stages: [commit-msg]
