#!/usr/bin/env python3
"""Weekly transcript mining: recurring failures in this workspace's Claude Code sessions (stdlib only).

Reads ~/.claude/projects/<workspace dirs>/*.jsonl modified in the last N days and reports what keeps going
wrong, so it can become a hook, a lint rule or an AGENTS.md line instead of being rediscovered:

  - tool errors, grouped by tool + normalized first line;
  - guard/hook blocks and sandbox/permission denials, grouped by reason;
  - Stop-gate blocks (check-fast failing at the end of a turn);
  - Bash commands that failed 3+ times;
  - cost per session (from the transcript's cost-state records).

Usage: scripts/mine_transcripts.py [--days 7] [--min 3] [--write]
  --write saves the report to brain/_inbox/mining/<YYYY>-W<ww>.md (gitignored) for the user's triage (/learn).
Transcripts are read locally; the report quotes error lines, never tool inputs beyond the command's first word.
"""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import errno
import glob
import importlib.util
import json
import os
import re
import sys
from pathlib import Path

# The hooks' hub.json reader, loaded by path and registered before it runs (its docstring says why).
_READER = importlib.util.spec_from_file_location(
    "hub_stdlib_reader", Path(__file__).resolve().parents[1] / "plugin" / "hub-workflow" / "hooks" / "stdlib_reader.py")
reader = importlib.util.module_from_spec(_READER)
sys.modules[_READER.name] = reader
_READER.loader.exec_module(reader)


def find_hub_json(start: Path | None = None) -> Path:
    """hub.json: $HUB_CONFIG, else the first one found walking up from this file."""
    env = os.environ.get("HUB_CONFIG")
    if env:
        path = Path(env).resolve()
        if not path.is_file():  # the reader would fall back to defaults: a report needs the real config
            raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), str(path))
        return path
    here = (start or Path(__file__)).resolve()
    for d in [here, *here.parents]:
        candidate = d / "hub.json" if d.is_dir() else d.parent / "hub.json"
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("hub.json not found (set HUB_CONFIG or run inside a hub)")


HUB = Path(__file__).resolve().parents[1]
PROJECTS = Path(os.path.expanduser("~/.claude/projects"))
SECRETISH = re.compile(r"(?i)(key|token|secret|password)=\S+")
# Hook markers are `[<plugin> stop-gate]`, `[<plugin> guard]`: match any plugin name.
STOP_GATE = re.compile(r"\[[\w-]+ stop-gate\]")
HOOK_MARK = re.compile(r"\[[\w-]+ (?:guard|stop-gate)\b")


def project_key(path: Path) -> str:
    """Claude Code's ~/.claude/projects dir name for a cwd: every non-alphanumeric char becomes `-`."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def workspace(hub: Path | None = None) -> Path:
    """The hub folder's parent, corrected when hub.json was found in a hub worktree (<hub>/.claude/worktrees/<x>)."""
    hub = hub or find_hub_json().parent
    parts = hub.parts
    for i in range(len(parts) - 1):
        if parts[i] == ".claude" and parts[i + 1] == "worktrees":
            return Path(*parts[:i]).parent
    return hub.parent


def transcript_dirs(hub: Path | None = None, projects: Path = PROJECTS) -> list[Path]:
    """Transcript dirs of sessions started anywhere under the workspace (hub, repos, their worktrees)."""
    key = project_key(workspace(hub))
    return sorted(d for d in projects.glob(key + "*") if d.is_dir() and (d.name == key or d.name.startswith(key + "-")))


def normalize(text: str) -> str:
    line = next((ln.strip() for ln in text.splitlines() if ln.strip() and not ln.startswith("Exit code")), "")
    line = SECRETISH.sub(r"\1=***", line)
    line = re.sub(r"/Users/[^\s:'\"]+", "<path>", line)
    line = re.sub(r"\b[0-9a-f]{7,40}\b", "<sha>", line)
    line = re.sub(r"\d+", "N", line)
    return line[:140]


def _text(content: object) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(str(b.get("text", "")) for b in content if isinstance(b, dict))
    return ""


def mine(files: list[Path], min_count: int = 3) -> dict[str, object]:
    tool_errors: collections.Counter[tuple[str, str]] = collections.Counter()
    blocks: collections.Counter[str] = collections.Counter()
    stop_gate = 0
    bash_fail: collections.Counter[str] = collections.Counter()
    costs: list[tuple[str, float]] = []
    sessions = 0
    for f in files:
        sessions += 1
        tool_names: dict[str, tuple[str, str]] = {}
        with open(f, encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
        for raw in lines:
            try:
                rec = json.loads(raw)
            except json.JSONDecodeError:
                continue
            kind = rec.get("type")
            if kind == "cost-state":
                costs.append((f.stem[:8], float(rec.get("totalCostUSD") or 0)))
                continue
            content = (rec.get("message") or {}).get("content")
            if not isinstance(content, list):
                if kind in ("user", "system") and STOP_GATE.search(_text(content)):
                    stop_gate += 1
                continue
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "tool_use":
                    cmd = str((b.get("input") or {}).get("command", ""))
                    tool_names[b.get("id", "")] = (str(b.get("name")), cmd.split()[0] if cmd.split() else "")
                elif b.get("type") == "tool_result" and b.get("is_error"):
                    tool, first_word = tool_names.get(b.get("tool_use_id", ""), ("?", ""))
                    msg = _text(b.get("content"))
                    low = msg.lower()
                    if "hook" in low or HOOK_MARK.search(msg) or "denied" in low or "not allowed" in low or "classifier" in low:
                        blocks[normalize(msg)] += 1
                    else:
                        tool_errors[(tool, normalize(msg))] += 1
                        if tool == "Bash" and first_word:
                            bash_fail[first_word] += 1
                elif b.get("type") == "text" and STOP_GATE.search(str(b.get("text", ""))):
                    stop_gate += 1
    return {
        "sessions": sessions,
        "tool_errors": [(t, m, n) for (t, m), n in tool_errors.most_common(15)],
        "blocks": blocks.most_common(10),
        "stop_gate": stop_gate,
        "bash_fail": [(c, n) for c, n in bash_fail.most_common(10) if n >= min_count],
        "cost_total": round(sum(c for _, c in costs), 2),
        "cost_top": sorted(costs, key=lambda x: -x[1])[:5],
        "recurring": [(t, m, n) for (t, m), n in tool_errors.most_common() if n >= min_count][:10],
    }


def render(r: dict[str, object], days: int) -> str:
    out = [f"# Transcript mining — last {days} days ({dt.date.today()})", "",
           f"Sessions: {r['sessions']} · cost (sessions with cost records): ${r['cost_total']} · Stop-gate blocks: {r['stop_gate']}", ""]
    out += ["## Recurring tool errors (candidates for a hook, lint or AGENTS.md line)", ""]
    out += [f"- {n}× **{t}**: `{m}`" for t, m, n in r["recurring"]] or ["- none at the threshold"]
    out += ["", "## Guard / hook / permission blocks", ""]
    out += [f"- {n}× `{m}`" for m, n in r["blocks"]] or ["- none"]
    out += ["", "## Bash commands failing repeatedly (first word)", ""]
    out += [f"- {n}× `{c}`" for c, n in r["bash_fail"]] or ["- none at the threshold"]
    out += ["", "## Most expensive sessions", ""]
    out += [f"- `{s}` ${c:.2f}" for s, c in r["cost_top"]] or ["- no cost records"]
    out += ["", "Triage: a recurring item becomes a /learn proposal (gotcha, hook or lint), or is dismissed with a reason.", ""]
    return "\n".join(out)


def transcript_files(days: int) -> list[Path]:
    cutoff = dt.datetime.now().timestamp() - days * 86400
    files = [Path(p) for d in transcript_dirs() for p in glob.glob(str(d / "*.jsonl"))]
    return sorted({f for f in files if f.stat().st_mtime >= cutoff})


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--min", type=int, default=3)
    ap.add_argument("--write", action="store_true")
    a = ap.parse_args(argv)
    report = render(mine(transcript_files(a.days), a.min), a.days)
    print(report)
    if a.write:
        year, week, _ = dt.date.today().isocalendar()
        out = HUB / "brain" / "_inbox" / "mining" / f"{year}-W{week:02d}.md"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(report, encoding="utf-8")
        print(f"written: {out.relative_to(HUB)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
