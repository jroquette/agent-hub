#!/usr/bin/env python3
"""SessionStart: inject the session brief. After a compaction, also re-inject the pre-compact snapshot.

The brief is the pinned release's `hub brief`, resolved as the hub's ./hub shim resolves it: first
`uvx --from <platform source>@v<version> hub --version`, then the same source's `hub brief`, the
version read from hub.json (platform.version). Both calls run from the hub with AGENT_HUB_ROOT set
to it, within one 10 s deadline inside the hook's 20 s; the brief is capped at 8000 characters.
When it cannot run, the mini brief stands in: one header line naming the fallback and its cause
(no version, no uv, resolve failed, failed (exit N), failed (no output), failed (cannot start),
timed out; failed for any other error), brain/now.md (a regular file only) capped at 2500
characters and the latest 3 journal files. The mini brief uses no git and no network."""

from __future__ import annotations

import os
import shutil
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from hubhooks import emit, load_config, read_input, run_hook
except Exception as error:  # a partial install: skip, never error the session
    print(f"[hub {os.path.splitext(os.path.basename(sys.argv[0] or 'hook'))[0]}] skipped: {type(error).__name__}", file=sys.stderr)
    sys.exit(0)

# The platform's git source at the pinned release; the version comes from hub.json at run time.
SOURCE = "@@{platform_repository}@v{version}#subdirectory=packages/agent-hub"
BRIEF_TIMEOUT = 10  # seconds for both calls together, inside the hook's 20 s
BRIEF_CAP = 8000
NOW_CAP = 2500
SNAPSHOT_CAP = 2500
JOURNAL_COUNT = 3


def pinned_brief(hub: Path, version: str | None) -> tuple[str, str]:
    """(the brief of `hub brief`, "") or ("", why it is missing: the cause the mini brief names)."""
    if version is None:
        return "", "no version"
    uvx = shutil.which("uvx")
    if uvx is None:
        return "", "no uv"
    release = [uvx, "--from", SOURCE.format(version=version), "hub"]
    env = dict(os.environ, AGENT_HUB_ROOT=str(hub))
    deadline = time.monotonic() + BRIEF_TIMEOUT
    code, _, cause = run_call(release + ["--version"], hub, env, deadline)
    if cause:
        return "", cause
    if code != 0:
        return "", "resolve failed"
    code, out, cause = run_call(release + ["brief"], hub, env, deadline)
    if cause:
        return "", cause
    if code != 0:
        return "", f"failed (exit {code})"
    brief = out.decode("utf-8", "replace").strip()[:BRIEF_CAP]
    if not brief:
        return "", "failed (no output)"
    return brief, ""


def run_call(argv: list[str], hub: Path, env: dict[str, str], deadline: float) -> tuple[int, bytes, str]:
    """(exit code, stdout, "") of one call from the hub, or (0, b"", cause) when it cannot finish."""
    try:
        proc = subprocess.Popen(argv, cwd=hub, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:  # found on PATH but cannot start
        return 0, b"", "failed (cannot start)"
    try:
        out, _ = proc.communicate(timeout=max(deadline - time.monotonic(), 0))
    except subprocess.TimeoutExpired:
        stop(proc)
        return 0, b"", "timed out"
    except BaseException:  # interrupted: never leave the call's group running
        stop(proc)
        raise
    return proc.returncode, out, ""


def stop(proc: subprocess.Popen) -> None:
    """Kill the timed-out call's whole process group: uvx runs `hub` as its own child."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:  # already gone
        pass
    try:
        proc.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        proc.kill()


def latest_journal(hub: Path) -> list[str]:
    """The newest JOURNAL_COUNT journal files (by path, the template excluded), newest first."""
    try:
        days = sorted(p.relative_to(hub).as_posix() for p in (hub / "brain" / "journal").glob("**/*.md") if p.name != "_template.md" and p.is_file())
    except OSError:
        return []
    return days[::-1][:JOURNAL_COUNT]


def mini_brief(hub: Path, cause: str) -> str:
    """The fallback brief: its header (with the cause), now.md capped, the latest journal files."""
    parts = [f"# Brief (fallback: hub brief {cause})"]
    now = hub / "brain" / "now.md"
    try:
        if stat.S_ISREG(os.stat(now).st_mode):  # a FIFO would block the read
            parts.append(now.read_text(encoding="utf-8", errors="replace")[:NOW_CAP].strip())
    except OSError:
        pass
    days = latest_journal(hub)
    if days:
        parts.append("Latest journal: " + ", ".join(days))
    return "\n\n".join(part for part in parts if part)


def main() -> None:
    data = read_input()
    cfg = load_config(data.get("cwd"))
    hub = cfg.hub
    if not hub:
        return
    try:
        brief, cause = pinned_brief(hub, cfg.hub_file.platform.version)
    except Exception:  # an unforeseen error still leaves the session its mini brief
        brief, cause = "", "failed"
    ctx = brief or mini_brief(hub, cause)
    snap = hub / "brain" / "auto" / "workspace" / "session-snapshot.md"
    if data.get("source") == "compact" and snap.exists():
        try:
            if stat.S_ISREG(os.stat(snap).st_mode):  # a FIFO would block the read
                ctx += "\n\n## Snapshot before compaction\n" + snap.read_text(encoding="utf-8", errors="replace")[:SNAPSHOT_CAP]
        except OSError:  # an unreadable snapshot (a folder, no permission): the brief alone
            pass
    emit({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}})


if __name__ == "__main__":
    run_hook(main)
