"""The hooks' ``hub.json`` and ``hub.local.json`` reader: stdlib only, Python 3.9, never raises.

Hooks run on the system ``python3`` (3.9 on macOS) with no dependencies, so this module imports
nothing outside the standard library and nothing else from agent-hub; agent-hub's tests run it on
a real 3.9 and lint it with ruff at ``--target-version py39``. A hook must never fail because of
``hub.json`` (docs/design/project-config.md § Readers): where ``HubConfig`` would reject the file,
this reader falls back instead.

- A key that is absent, of the wrong type, or an empty string takes its default, and only that
  key: the rest of the file is kept. A list with any item that is not a string is ``()``.
- ``tracker.team_keys`` is ``tracker.teams`` when it is a non-empty list of non-empty strings,
  else ``(team,)`` when ``tracker.team`` is a non-empty string, else ``()``; ``team`` keeps its
  own value (``""`` when ``teams`` is set).
- The defaults of optional keys equal ``HubConfig``'s (the consistency test is
  ``packages/generator/tests/integration/test_hub_json_reader.py``). Required strings default
  to ``""``, ``project.name`` to the name of the directory holding the file (then ``hub``), and a
  repo without a non-empty string ``dir`` is dropped.
- ``platform.version`` counts only as three ASCII numbers (``0.2.0``); anything else is ``None``.
- ``platform.repository`` is the value as written when it is a string of at most 200 characters
  with the model's pattern; else ``None``. Present but not that (``null`` and ``""`` included),
  it also sets ``has_bad_repository``, which the hook reports instead of using the default.
- ``repos[].check_fast_timeout`` counts only as a JSON integer from 1 to 160; anything else is
  ``None``, the gate's default.
- A repo's ``default_branch`` is its effective value: its own when it is a string matching the
  model's branch pattern, else the ``project`` section's ``default_branch`` (it inherits).
- ``guard.infra`` is ``None`` when absent. Present, ``InfraSection.problem`` names the first value
  the guard cannot use, and that key's tuple is ``()``: ``guard.infra`` when it is not an object
  (``null`` included), ``guard.infra.<key>`` when its value is not a list (``null`` included), and
  ``guard.infra.<key>[<i>]`` for an item that is not a string, is blank or holds a control
  character. Unknown keys under it are ignored; patterns are compiled by the guard, not here.
- Unknown keys and comment keys (``_`` first) are ignored. ``modules`` and ``doctor.rules`` keep
  each entry's settings, minus comment keys, without checking them.
- ``hub.local.json`` (one developer's ``project.branch_prefix``, ``author_name``,
  ``author_email`` and ``tracker.transport``) counts only as a regular file of at most
  ``LOCAL_FILE_MAX_BYTES``; otherwise it sets nothing. A local value counts only when it is a
  string with the model's shape (pattern, or ``api``/``mcp``), else that key falls through.
  ``EffectiveValues`` gives each key from ``hub.local.json``, else ``hub.json``, else git config
  (asked lazily, once per key); with no prefix in a file, the prefix is the effective email's
  local part plus ``/`` when that is a valid prefix (docs/design/developer-identity.md).

A hook that loads this file by path must register the module before running it, or the frozen
dataclasses fail to build (``AttributeError`` on ``NoneType.__dict__``)::

    spec = importlib.util.spec_from_file_location("hub_stdlib_reader", path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
"""

from __future__ import annotations

import json
import os
import re
import stat
from collections.abc import Callable
from dataclasses import dataclass, field

COMMENT_KEY_PREFIX = "_"
FALLBACK_PROJECT_NAME = "hub"
LOCAL_FILE = "hub.local.json"
LOCAL_FILE_MAX_BYTES = 65_536
TRANSPORTS = ("api", "mcp")
PREFIX_FROM_LOCAL = LOCAL_FILE
PREFIX_FROM_HUB = "hub.json"
PREFIX_DERIVED = "derived"
# ``[0-9]`` and ``fullmatch``: ``\d`` takes any Unicode digit and ``$`` a final newline.
RELEASE_VERSION = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
# The model's ``PlatformRepository`` pattern, for ``fullmatch``, rendered from agent-hub's core.
PLATFORM_REPOSITORY = re.compile(r"@@{platform_repository_pattern}")
PLATFORM_REPOSITORY_MAX_CHARS = 200
# The model's bounds for ``repos[].check_fast_timeout``.
CHECK_FAST_TIMEOUT_MIN = 1
CHECK_FAST_TIMEOUT_MAX = 160
# The model's ``BranchName`` pattern without ``^`` and ``$``, for ``fullmatch``. No separator
# character is also a segment character, so ``re`` matches in linear time.
BRANCH_NAME = re.compile(
    r"[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*(?:/[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*)*"
)
# The model's ``BranchPrefix``, ``EmailAddress`` and ``FreeString`` patterns, likewise.
BRANCH_PREFIX = re.compile(r"[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*/")
EMAIL_ADDRESS = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+")
FREE_STRING = re.compile(r"[^\x00-\x1f\x7f]+")
# A character ``FREE_STRING`` refuses: an infra pattern holding one is unusable.
CONTROL_CHARACTER = re.compile(r"[\x00-\x1f\x7f]")
# The git config key each git-read identity key comes from.
GIT_KEYS = {"author_name": "user.name", "author_email": "user.email"}


@dataclass(frozen=True)
class PlatformSection:
    """``platform``: the release the hub is pinned to, ``None`` when absent or malformed.

    ``repository`` is the source as written, ``None`` when absent or bad; ``has_bad_repository``
    tells a bad one from an absent one.
    """

    version: str | None = None
    repository: str | None = None
    has_bad_repository: bool = False


@dataclass(frozen=True)
class ProjectSection:
    """``project``."""

    name: str = FALLBACK_PROJECT_NAME
    hub_repo: str = ""
    branch_prefix: str = ""
    default_branch: str = "main"
    author_name: str = ""
    author_email: str = ""


@dataclass(frozen=True)
class TrackerSection:
    """``tracker``: ``team_keys`` are the configured team keys in order, the first the default."""

    kind: str = ""
    team: str = ""
    team_keys: tuple[str, ...] = ()
    ready_label: str = "agent-ready"
    failed_label: str = "agent-failed"
    transport: str = "api"


@dataclass(frozen=True)
class RepoEntry:
    """One ``repos[]`` item; items without a ``dir`` are dropped.

    ``default_branch`` is the effective value: the repo's own, else the project's.
    """

    dir: str
    github: str = ""
    role: str = "app"
    check_fast: str = ""
    check_fast_timeout: int | None = None
    check: str = ""
    default_branch: str = "main"


@dataclass(frozen=True)
class InfraSection:
    """``guard.infra``; ``problem`` names the first value the guard cannot use."""

    allow: tuple[str, ...] = ()
    prod_markers: tuple[str, ...] = ()
    problem: str = ""


@dataclass(frozen=True)
class GuardSection:
    """``guard``; ``infra`` is ``None`` when ``guard.infra`` is absent."""

    ask_before_edit: tuple[str, ...] = ()
    deny_hosts: tuple[str, ...] = ()
    deny_paths: tuple[str, ...] = ()
    infra: InfraSection | None = None


@dataclass(frozen=True)
class DoctorSection:
    """``doctor``: each rule id with its settings, unchecked."""

    rules: dict[str, dict[str, object]] = field(default_factory=dict)


@dataclass(frozen=True)
class HubFile:
    """``hub.json`` as read by hooks; field names are the JSON keys."""

    schema_version: int | None = None
    platform: PlatformSection = field(default_factory=PlatformSection)
    project: ProjectSection = field(default_factory=ProjectSection)
    tracker: TrackerSection = field(default_factory=TrackerSection)
    repos: tuple[RepoEntry, ...] = ()
    guard: GuardSection = field(default_factory=GuardSection)
    modules: dict[str, dict[str, object]] = field(default_factory=dict)
    doctor: DoctorSection = field(default_factory=DoctorSection)


def load_hub_file(path: str | os.PathLike[str]) -> HubFile:
    """Read ``hub.json`` at ``path``; never raises (see the module docstring for the defaults)."""
    document = _read_document(path)
    project = _object(document.get("project"))
    tracker = _object(document.get("tracker"))
    guard = _object(document.get("guard"))
    schema_version = document.get("schema_version")
    project_branch = _text(project, "default_branch", ProjectSection.default_branch)
    return HubFile(
        # ``bool`` is an ``int``; only a JSON integer is a schema version.
        schema_version=schema_version if type(schema_version) is int else None,
        platform=_platform(_object(document.get("platform"))),
        project=ProjectSection(
            name=_text(project, "name", _directory_name(path)),
            hub_repo=_text(project, "hub_repo", ""),
            branch_prefix=_text(project, "branch_prefix", ""),
            default_branch=project_branch,
            author_name=_text(project, "author_name", ""),
            author_email=_text(project, "author_email", ""),
        ),
        tracker=TrackerSection(
            kind=_text(tracker, "kind", ""),
            team=_text(tracker, "team", ""),
            team_keys=_team_keys(tracker),
            ready_label=_text(tracker, "ready_label", TrackerSection.ready_label),
            failed_label=_text(tracker, "failed_label", TrackerSection.failed_label),
            transport=_text(tracker, "transport", TrackerSection.transport),
        ),
        repos=_repos(document.get("repos"), project_branch),
        guard=GuardSection(
            ask_before_edit=_texts(guard, "ask_before_edit"),
            deny_hosts=_texts(guard, "deny_hosts"),
            deny_paths=_texts(guard, "deny_paths"),
            infra=_infra(guard),
        ),
        modules=_settings_by_id(document.get("modules")),
        doctor=DoctorSection(rules=_settings_by_id(_object(document.get("doctor")).get("rules"))),
    )


@dataclass(frozen=True)
class LocalFile:
    """``hub.local.json`` as read by hooks: each key's checked value, ``""`` when it sets none."""

    branch_prefix: str = ""
    author_name: str = ""
    author_email: str = ""
    transport: str = ""


def load_local_file(path: str | os.PathLike[str]) -> LocalFile:
    """Read ``hub.local.json`` at ``path``; never raises (see the module docstring)."""
    document = _read_document(path, max_bytes=LOCAL_FILE_MAX_BYTES)
    project = _object(document.get("project"))
    transport = _text(_object(document.get("tracker")), "transport", "")
    return LocalFile(
        branch_prefix=_matching(project, "branch_prefix", BRANCH_PREFIX),
        author_name=_matching(project, "author_name", FREE_STRING),
        author_email=_matching(project, "author_email", EMAIL_ADDRESS),
        transport=transport if transport in TRANSPORTS else "",
    )


class EffectiveValues:
    """One developer's identity and transport: ``hub.local.json``, else ``hub.json``, else git.

    ``git_value(key)`` gives git's output for ``git config --get <key>`` (``user.name``,
    ``user.email``), ``""`` when unset or when git fails. It is called only for a key no file
    sets, at most once per key, and never while the object is built. Its value loses one
    trailing newline and then counts only with the model's shape. ``hub.json``'s values are used
    unchecked, as elsewhere in this reader; a derived prefix counts only when it matches
    ``BRANCH_PREFIX``. Every method gives ``""`` when no source gives a value.
    """

    def __init__(self, hub_file: HubFile, local_file: LocalFile, git_value: Callable[[str], str]):
        self.hub_file = hub_file
        self.local_file = local_file
        self.transport = local_file.transport or hub_file.tracker.transport
        self._git_value = git_value
        self._git: dict[str, str] = {}

    def author_name(self) -> str:
        return self._value("author_name", FREE_STRING)

    def author_email(self) -> str:
        return self._value("author_email", EMAIL_ADDRESS)

    def branch_prefix(self) -> str:
        """The file's prefix, else the effective email's local part plus ``/`` when valid."""
        from_file = self.local_file.branch_prefix or self.hub_file.project.branch_prefix
        if from_file:
            return from_file
        derived = self.author_email().rpartition("@")[0] + "/"
        return derived if BRANCH_PREFIX.fullmatch(derived) else ""

    def prefix_source(self) -> str:
        """``hub.local.json``, ``hub.json``, ``derived``, or ``""`` when there is no prefix."""
        if self.local_file.branch_prefix:
            return PREFIX_FROM_LOCAL
        if self.hub_file.project.branch_prefix:
            return PREFIX_FROM_HUB
        return PREFIX_DERIVED if self.branch_prefix() else ""

    def _value(self, key: str, pattern: re.Pattern[str]) -> str:
        from_file = getattr(self.local_file, key) or getattr(self.hub_file.project, key)
        if from_file:
            return from_file
        git_key = GIT_KEYS[key]
        if git_key not in self._git:
            value = self._git_value(git_key)
            # As the CLI: one trailing newline is git's own, anything else is the value's.
            value = value[:-1] if value.endswith("\n") else value
            self._git[git_key] = value if _is_shaped(value, pattern) else ""
        return self._git[git_key]


def _read_document(
    path: str | os.PathLike[str], max_bytes: int | None = None
) -> dict[str, object]:
    """The file's top-level object; ``{}`` when it cannot be read, is larger than ``max_bytes``
    or is not a JSON object."""
    # Only a regular file (a symlink to one included): opening a FIFO blocks and a device such as
    # /dev/zero never ends, so a hook would hang. The check by path skips the open; what was
    # opened (without blocking) is checked again, so a FIFO swapped in after it is not read.
    if not os.path.isfile(path):
        return {}
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0))
        with open(descriptor, "rb") as file:
            if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
                return {}
            if max_bytes is None:
                content = file.read()
            else:
                # One byte more than allowed tells a file that grew after any size check.
                content = file.read(max_bytes + 1)
                if len(content) > max_bytes:
                    return {}
        return _object(json.loads(content.decode("utf-8")))
    # OSError: missing, a directory, unreadable. ValueError: bad UTF-8 or JSON (and a NUL in the
    # path). RecursionError: nesting deeper than the parser's stack.
    except (OSError, ValueError, RecursionError):
        return {}


def _directory_name(path: str | os.PathLike[str]) -> str:
    """The name of the hub directory, the one holding the file (``hubhooks.py`` does the same)."""
    try:
        directory = os.path.dirname(os.path.abspath(path))
    # A relative path needs the working directory, which may have been deleted.
    except OSError:
        return FALLBACK_PROJECT_NAME
    return os.path.basename(directory) or FALLBACK_PROJECT_NAME


def _object(value: object) -> dict[str, object]:
    """A JSON object without its comment keys; anything else is an empty object."""
    if not isinstance(value, dict):
        return {}
    return {key: item for key, item in value.items() if not key.startswith(COMMENT_KEY_PREFIX)}


def _text(section: dict[str, object], key: str, default: str) -> str:
    value = section.get(key)
    return value if isinstance(value, str) and value else default


def _matching(section: dict[str, object], key: str, pattern: re.Pattern[str]) -> str:
    """The value at ``key`` when it is a string with ``pattern``'s shape, else ``""``."""
    value = _text(section, key, "")
    return value if _is_shaped(value, pattern) else ""


def _is_shaped(value: str, pattern: re.Pattern[str]) -> bool:
    """Whether ``pattern`` matches all of ``value`` and ``value`` is UTF-8 text, as the model asks.

    A lone surrogate (JSON ``"\\ud800"``) passes a negated character class but not the model.
    """
    if not pattern.fullmatch(value):
        return False
    try:
        value.encode("utf-8", "strict")
    except UnicodeEncodeError:
        return False
    return True


def _bounded_int(section: dict[str, object], key: str, low: int, high: int) -> int | None:
    """The value at ``key`` when it is a JSON integer from ``low`` to ``high``, else ``None``."""
    value = section.get(key)
    if type(value) is int and low <= value <= high:
        return value
    return None


def _texts(section: dict[str, object], key: str) -> tuple[str, ...]:
    value = section.get(key)
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return tuple(value)
    return ()


def _infra(guard: dict[str, object]) -> InfraSection | None:
    """``guard.infra``: ``None`` when absent; else its lists, with the first unusable location."""
    if "infra" not in guard:
        return None
    infra = guard["infra"]
    if not isinstance(infra, dict):
        return InfraSection(problem="guard.infra")
    section = _object(infra)
    allow, allow_problem = _patterns(section, "allow")
    prod_markers, markers_problem = _patterns(section, "prod_markers")
    return InfraSection(
        allow=allow, prod_markers=prod_markers, problem=allow_problem or markers_problem
    )


def _patterns(section: dict[str, object], key: str) -> tuple[tuple[str, ...], str]:
    """The list at ``key`` and ``""``; ``()`` and the location of the first unusable value."""
    if key not in section:
        return (), ""
    location = "guard.infra." + key
    value = section[key]
    if not isinstance(value, list):
        return (), location
    for index, item in enumerate(value):
        if not isinstance(item, str) or not item.strip() or CONTROL_CHARACTER.search(item):
            return (), f"{location}[{index}]"
    return tuple(value), ""


def _team_keys(tracker: dict[str, object]) -> tuple[str, ...]:
    """``teams`` when every item is a non-empty string, else ``(team,)``, else ``()``."""
    teams = _texts(tracker, "teams")
    if teams and all(teams):
        return teams
    team = _text(tracker, "team", "")
    return (team,) if team else ()


def _platform(platform: dict[str, object]) -> PlatformSection:
    version = _version(platform)
    if "repository" not in platform:
        return PlatformSection(version=version)
    value = platform["repository"]
    if (
        isinstance(value, str)
        and len(value) <= PLATFORM_REPOSITORY_MAX_CHARS
        and _is_shaped(value, PLATFORM_REPOSITORY)
    ):
        return PlatformSection(version=version, repository=value)
    return PlatformSection(version=version, has_bad_repository=True)


def _version(platform: dict[str, object]) -> str | None:
    value = platform.get("version")
    if isinstance(value, str) and RELEASE_VERSION.fullmatch(value):
        return value
    return None


def _branch(repo: dict[str, object], project_branch: str) -> str:
    """The repo's ``default_branch`` when it matches ``BRANCH_NAME``, else ``project_branch``."""
    value = repo.get("default_branch")
    if isinstance(value, str) and BRANCH_NAME.fullmatch(value):
        return value
    return project_branch


def _repos(value: object, project_branch: str) -> tuple[RepoEntry, ...]:
    items = value if isinstance(value, list) else []
    repos = [_object(item) for item in items]
    return tuple(
        RepoEntry(
            dir=_text(repo, "dir", ""),
            github=_text(repo, "github", ""),
            role=_text(repo, "role", RepoEntry.role),
            check_fast=_text(repo, "check_fast", ""),
            check_fast_timeout=_bounded_int(
                repo, "check_fast_timeout", CHECK_FAST_TIMEOUT_MIN, CHECK_FAST_TIMEOUT_MAX
            ),
            check=_text(repo, "check", ""),
            default_branch=_branch(repo, project_branch),
        )
        for repo in repos
        if _text(repo, "dir", "")
    )


def _settings_by_id(value: object) -> dict[str, dict[str, object]]:
    """``modules`` or ``doctor.rules``: each id whose settings are an object, minus comment keys."""
    return {key: _object(item) for key, item in _object(value).items() if isinstance(item, dict)}
