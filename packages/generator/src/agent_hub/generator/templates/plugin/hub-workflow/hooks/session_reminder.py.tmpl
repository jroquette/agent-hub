#!/usr/bin/env python3
"""UserPromptSubmit: remind the owner once per session to hand off and start a new session.

Input: Claude Code's UserPromptSubmit event on stdin, a JSON object with ``session_id`` and
``cwd`` (the hub is found from it).

The per-session record ``<hub>/.agent-runs/sessions/<session id>.json`` (``hubhooks``'
``session_record`` and ``save_session_record``) is ``{"started", "compactions", "reminded"}``:
``pre_compact.py`` counts the compactions; this hook creates the record on the session's first
prompt, so ``started`` is when the session began.

Limits: once ``compactions >= COMPACTION_LIMIT`` or ``now - started >= OPEN_LIMIT`` seconds, and
the record is not ``reminded``, it sets ``reminded`` and prints one JSON line
``{"systemMessage": <reminder>}``; when both hold the reminder names the compactions.

Output: that one line, or nothing. A prompt is never blocked.

Fail open: no hub, stdin that is not a JSON object, a session id without the safe shape, a record
that cannot be written or a missing ``hubhooks.py`` print nothing and exit 0. The reminder is
printed only once ``reminded`` is saved, so it is never repeated.
"""

from __future__ import annotations

import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from hubhooks import find_hub, read_input, save_session_record, session_record
except Exception:  # a partial install: fail open, print nothing
    sys.exit(0)

COMPACTION_LIMIT = 2
OPEN_LIMIT = 2 * 24 * 60 * 60
COMPACTED = (
    "[hub] This session has been compacted twice or more: run /handoff, then start a new session "
    "for the next work."
)
OPEN = (
    "[hub] This session has been open for 2 days: run /handoff, then start a new session for the "
    "next work."
)


def reminder(record: dict, now: int) -> str | None:
    """The reminder the record is due, or None (already reminded, or under both limits)."""
    if record["reminded"]:
        return None
    if record["compactions"] >= COMPACTION_LIMIT:
        return COMPACTED
    if now - record["started"] >= OPEN_LIMIT:
        return OPEN
    return None


def main() -> int:
    try:
        event = read_input()
        hub = find_hub(event.get("cwd"))
        session_id = event.get("session_id")
        if hub is None:
            return 0
        record = session_record(hub, session_id)
        if record is None:  # an unsafe session id keeps no record
            return 0
        message = reminder(record, int(time.time()))
        if message is not None:
            record["reminded"] = True
        # Saved on every prompt: a missing or unreadable record becomes a fresh one now.
        save_session_record(hub, session_id, record)
    except Exception:  # fail open: a prompt hook never blocks or garbles a prompt
        return 0
    if message is None:
        return 0
    try:
        sys.stdout.write(json.dumps({"systemMessage": message}) + "\n")
        sys.stdout.flush()
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
