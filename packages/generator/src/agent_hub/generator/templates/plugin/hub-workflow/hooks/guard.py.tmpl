Verdict = Optional[tuple[str, str]]

NON_SECRET_ENV = {".env.example", ".env.development", ".env.staging", ".env.test", ".env.sample", ".env.template"}
SECRET_FILE = re.compile(r"(^|/)(\.env(\.[\w.-]+)?|[^/]*\.(pem|key|p12|pfx)|id_(rsa|ed25519)[^/]*)$")
AI_ATTRIBUTION = re.compile(r"co-authored-by:\s*[^\n]*(claude|anthropic|openai|copilot|\bai\b)|generated with \[?claude|🤖", re.I)
SECRET_TOKEN = re.compile(
    r"(?<![\w-])[<'\"]?(\S*/)?(\.env(\.[\w.-]+)?|[\w.-]+\.(pem|key|p12|pfx)|id_(rsa|ed25519|ecdsa)[\w.-]*)(?=[\s'\";|&)<>]|$)"
)
SAFE_ON_SECRETS = {"ls", "test", "[", "stat"}  # these never print file contents
GIT = r"\bgit(\s+-[Cc]\s+\S+)*\s+"
SKIP_MARKERS = re.compile(
    r"@pytest\.mark\.(skip|skipif|xfail|quarantine)\b|\bpytest\.(skip|xfail)\(|\b(test|it|describe)\.(skip|fixme|todo)\(|\bx(it|describe)\("
)
TEST_PATH = r"(?:(\S*/)?(tests?|__tests__)/\S+|\S+\.(test|spec)\.[jt]sx?\b|['\"]?(\S*/)?test_\w+\.py\b)"
# guard.infra: the covered tools, each as a word followed by an optional closing quote, blanks and
# an argument (group 2 starts at it; a lookahead, so a tool word that is another tool's first
# argument is a mention too), by a redirection glued to it (`aws>/dev/null`, `aws&>log`), or by
# nothing but blanks up to the end of its part or call (`xargs aws`, `(aws)`; these two have no
# group 2, never a local form), anywhere in a part, so wrappers, quotes and redirections do not hide it.
INFRA_TOOLS = ("aws", "cdk", "terraform", "pulumi", "kubectl", "helm", "sam", "serverless")
INFRA_TOOL = re.compile(
    r"\b(" + "|".join(INFRA_TOOLS) + r")\b(?:['\"]?\s+(?=(\S))|(?=\d*[<>]|&>)|(?=['\"]?\s*(?:[&()`{}]|\Z)))"
)
# The parts of a command: split at `&&`, `||`, `;`, `|` and newlines; each part is checked whole,
# then each tool mention in it against the call that holds it (the part split at a single `&`, `(`,
# `)`, a backtick, `{` and `}`, so `$(…)`, `<(…)`, subshells and groups), so an allowed call never
# covers another one beside it.
INFRA_PART = re.compile(r"&&|\|\||[;|\n]")
INFRA_CALL = re.compile(r"[&()`{}]")
# The characters the shell reader looks at: quotes ('…', "…", and `$'…'`, where a backslash escapes
# the next character; `$$` is a token of its own), backslashes, a comment's `#` (at the start or
# after a blank or an operator) and newlines.
INFRA_LEX = re.compile(r"[\\'\"#\n$]")
INFRA_WORD_BREAK = re.compile(r"[\s;&|()<>]")
INFRA_QUOTE_NEXT = {"": re.compile("['\"]"), "'": re.compile("'"), '"': re.compile('"')}  # by open quote
INFRA_WORD_PIECE = re.compile(r"[^\s;&|()<>]*")
INFRA_WORD_TAIL = re.compile(r"[^\s;&|()<>]*\Z")
# E21 simple-or-ask: the constructs the guard does not model. An infra allow (or local form) holds
# only for a command that has none of them; else it asks, naming the leftmost one.
INFRA_UNMODELLED = re.compile(r"\\|\$'|\$\$|`|#|<<<?|(?<![\w-])(?:xargs|eval|exec|source)(?![\w-])")
INFRA_DOT = re.compile(
    r"(?:^|[;&|(){}!\n]|(?<![\w-])(?:then|do|else|elif|if|while|until|time|command|builtin)(?=\s))\s*(\.)(?=[\s;&|)]|\Z)"
)
INFRA_SHELL_WORD = re.compile(r"(?<![\w.-])(?:ba|z|da)?sh(?![\w.-])")
INFRA_SHELL_C = re.compile(r"(?<![\w-])-[a-zA-Z]*c[a-zA-Z]*(?![\w-])")
INFRA_END = r"(?![\w-])"
INFRA_WORD = r"(?<![\w-])({})" + INFRA_END
# Local-only forms, matched at the tool's first argument; kubectl's version needs --client in the
# call, terraform's init needs -backend=false, each with no later `--client=` (other than `true`) or
# `-backend=` (the last flag wins).
INFRA_LOCAL_ANY = re.compile(r"(--version|version|help|--help)" + INFRA_END)
INFRA_LOCAL = {
    "cdk": re.compile(r"(synth|ls|list|init|doctor|context)" + INFRA_END),
    "terraform": re.compile(r"(fmt|validate)" + INFRA_END),
    "helm": re.compile(r"(template|lint)" + INFRA_END),
    "sam": re.compile(r"(build|validate)" + INFRA_END),
}
INFRA_KUBECTL_VERSION = re.compile(r"(version|--version)" + INFRA_END)
INFRA_FLAG_END = r"(?=\s|$)"
INFRA_KUBECTL_CLIENT = re.compile(r"(?<![\w-])--client" + INFRA_FLAG_END)
INFRA_TERRAFORM_INIT = re.compile(r"init" + INFRA_END)
INFRA_NO_BACKEND = re.compile(r"(?<![\w-])-backend=false" + INFRA_FLAG_END)
# (needed flag, flags that keep it, flag word): the needed flag counts when the last flag word (in
# any spelling, quoted too) lies in a flag that keeps it.
INFRA_CLIENT = (INFRA_KUBECTL_CLIENT, re.compile(r"(?<![\w-])--client(?:=true)?" + INFRA_FLAG_END),
                re.compile(r"client(?![\w-])"))
INFRA_BACKEND = (INFRA_NO_BACKEND, INFRA_NO_BACKEND, re.compile(r"backend(?![\w-])"))


class _Verbs:
    """A tool's ask verbs (words, quotes allowed): ``search(part, pos)`` is the reason's name of the
    first one at or after pos, or None. A ``(lead, verbs)`` pair asks when one of ``verbs`` comes
    anywhere after ``lead`` (aws `s3 … rm`); each search runs once from pos, so a part costs one
    linear pass per pattern."""

    def __init__(self, words: str, *pairs: tuple[str, str]) -> None:
        self.words = re.compile(INFRA_WORD.format(words))
        self.pairs = [(re.compile(INFRA_WORD.format(lead)), re.compile(INFRA_WORD.format(verbs)))
                      for lead, verbs in pairs]

    def search(self, part: str, pos: int) -> str | None:
        found = []
        word = self.words.search(part, pos)
        if word:
            found.append((word.start(), word.group(1)))
        for lead, verbs in self.pairs:
            first = lead.search(part, pos)
            verb = verbs.search(part, first.end()) if first else None
            if first and verb:
                found.append((first.start(), f"{first.group(1)} {verb.group(1)}"))
        return min(found)[1] if found else None


# Verbs that ask on an allowed environment, searched as words anywhere after the tool's first
# mention in the part, once per tool.
INFRA_ASK_VERBS = {
    "aws": _Verbs(r"(?:delete|remove|terminate|deregister)-[\w-]+", ("s3", "rm|rb"),
                  ("cloudformation", "deploy|delete-stack")),
    "cdk": _Verbs("deploy|destroy"),
    "terraform": _Verbs("apply|destroy|import"),
    "pulumi": _Verbs("up|destroy"),
    "kubectl": _Verbs("apply|create|delete|replace|patch|scale"),
    "helm": _Verbs("install|upgrade|uninstall|rollback"),
    "sam": _Verbs("deploy|delete"),
    "serverless": _Verbs("deploy|remove"),
}
BASH_WRITE = re.compile(r">>?|\btee\b|\bsed\s+(-\w*i\w*|--in-place)\b|\b(rm|mv|cp|truncate|ln)\b")
WORKTREE_SEG = re.compile(r"/\.claude/worktrees/[^/]+(?=/)")
SETTINGS_FILE = re.compile(r"\.claude/settings[^/]*\.json")
# The hub-root launchers: the managed settings allow `./hub doctor` with no prompt.
LAUNCHERS = ("hub", "agent")
WRITE_TARGET = re.compile(r">>?\s*([^\s;&|<>()`]+)")
WRITE_ARGS = re.compile(r"\b(?:tee|sed\s+(?:-\w*i\w*|--in-place)|rm|mv|cp|truncate|ln)\b(.*)")
HUB_PREFIX = "@hub"


def _str(value: object) -> str:
    """A tool field as text: anything that is not a string counts as absent."""
    return value if isinstance(value, str) else ""


def _edits(ti: dict) -> list[dict]:
    """MultiEdit's edits: a list of objects, other items (and a non-list) dropped."""
    edits = ti.get("edits")
    return [e for e in edits if isinstance(e, dict)] if isinstance(edits, list) else []


def _read_text(path: str) -> str:
    """A file's text for the assertion and marker counts; "" when unreadable or not UTF-8."""
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, ValueError):
        return ""


def _secret_path(path: str) -> bool:
    if os.path.basename(path) in NON_SECRET_ENV:
        return False
    return bool(SECRET_FILE.search(path))


def _branch_hint(cfg: Config) -> str:
    """``<prefix>dem-<N>-<desc>`` for one team, ``<prefix><app|ops>-<N>-<desc>`` for several."""
    keys = [key.lower() for key in cfg.tracker_teams]
    segment = keys[0] if len(keys) == 1 else "<" + "|".join(keys) + ">"
    team = f"{segment}-<N>-" if keys else ""
    return f"{cfg.branch_prefix}{team}<desc>"


def _host_regex(pattern: str) -> str:
    """deny_hosts entry → regex; `*.example.com` covers subdomains, anything else is an exact host."""
    body = re.escape(pattern.strip().lower()).replace(r"\*", r"[\w-]+(?:\.[\w-]+)*")
    return r"(?<![\w.-])" + body + r"(?![\w-]|\.[\w-])"


def denied_host(text: str, cfg: Config) -> str | None:
    for h in cfg.deny_hosts:
        if re.search(_host_regex(h), text, re.I):
            return h
    return None


def _candidates(path: str, cfg: Config) -> list[str]:
    """path as given, absolute after `~` expansion, and with symlinks and `..` resolved (worktree segments
    dropped), plus each absolute form relative to the workspace. Lowercased: macOS file systems ignore case."""
    expanded = os.path.expanduser(path)
    full = os.path.abspath(expanded)
    try:
        real = os.path.realpath(expanded)  # not of full: abspath drops `..` before a link is followed
    except (OSError, ValueError):  # a NUL byte in the path
        real = full
    absolute = list(dict.fromkeys(WORKTREE_SEG.sub("", p).lower() for p in (full, real)))
    cands = [*absolute, path.lower()]
    if cfg.workspace:
        ws = str(cfg.workspace).rstrip("/").lower() + "/"
        cands += [p[len(ws):] for p in absolute if p.startswith(ws)]
    return cands


def _globs(pattern: str) -> list[str]:
    return [pattern] if any(c in pattern for c in "*?[") else [pattern.rstrip("/"), pattern.rstrip("/") + "/*"]


def _rules(entries: tuple[str, ...], cfg: Config) -> list[tuple[str, list[str], bool]]:
    """(entry, globs, anchored) per list entry. `@hub/<rest>` is anchored at the hub holding this file
    (its main checkout, so a hub worktree is covered too); with none, the entry is skipped."""
    rules = []
    for entry in entries:
        pat = entry.strip()
        if pat == HUB_PREFIX or pat.startswith(HUB_PREFIX + "/"):
            if cfg.root_hub is None:
                continue
            base = re.sub(r"([*?[])", r"[\1]", str(cfg.root_hub).rstrip("/"))
            rules.append((pat, [base + g for g in _globs(pat[len(HUB_PREFIX):])], True))
        else:
            rules.append((pat, _globs(pat), False))
    return rules


def _match(path: str, entries: tuple[str, ...], cfg: Config) -> str | None:
    """The list entry that covers path, if any.

    Entries are globs (fnmatch, `*` crosses `/`) matched against the absolute path, the path relative to the
    workspace, and any path suffix; an entry without glob characters is a file or directory prefix.
    Worktree segments (`<repo>/.claude/worktrees/<t>/`) are dropped first, so `app/src/auth/*` covers
    the same file in every worktree of `app`. `@hub/<rest>` entries match the absolute path only."""
    if not entries or not path:
        return None
    cands = _candidates(path, cfg)
    for pat, globs, anchored in _rules(entries, cfg):
        for g in (g.lower() for g in globs):
            for c in cands:
                if fnmatch(c, g) or (not anchored and fnmatch(c, "*/" + g.lstrip("/"))):
                    return pat
    return None


def protected(path: str, cfg: Config) -> str | None:
    """The guard.ask_before_edit entry that covers path, if any (see _match)."""
    return _match(path, cfg.ask_before_edit, cfg)


def denied_path(path: str, cfg: Config) -> str | None:
    """The guard.deny_paths entry that covers path, if any (see _match)."""
    return _match(path, cfg.deny_paths, cfg)


def _guard_dirs(cfg: Config) -> list[str]:
    project = cfg.root_project.lower()
    return ["plugin/hub-workflow/hooks"] + ([f"plugin/{project}/hooks"] if project and "/" not in project else [])


def _hub_base(cfg: Config) -> str | None:
    base = cfg.root_hub or cfg.hub
    return str(base).rstrip("/").lower() if base else None


def guard_file(path: str, cfg: Config, launchers: bool = True) -> str | None:
    """path relative to the hub when it is one of the guard's own files: its hooks, the project's
    hooks (the guard extension), .claude/settings*.json, hub.lock or hub.json, or (with launchers)
    the hub and agent launchers, in the hub holding this file or one of its worktrees (in the
    plugin cache: the hub found). Case is ignored."""
    base = _hub_base(cfg)
    if base is None or not path:
        return None
    head = base + "/"
    dirs = _guard_dirs(cfg)
    for c in _candidates(path, cfg):
        if not c.startswith(head):
            continue
        rel = c[len(head):]
        if any(rel == d or rel.startswith(d + "/") for d in dirs) or SETTINGS_FILE.fullmatch(rel) or rel in ("hub.lock", "hub.json") or (launchers and rel in LAUNCHERS):
            return rel
    return None


def guard_parent(path: str, cfg: Config) -> str | None:
    """The folder path names when it holds guard files: the hub itself, a folder above it, or a folder
    on the way to a guard file (.claude, plugin, plugin/hub-workflow, plugin/<project>, ...)."""
    base = _hub_base(cfg)
    if base is None or not path:
        return None
    parents = {"", ".claude"}
    for d in _guard_dirs(cfg):
        parts = d.split("/")
        parents |= {"/".join(parts[:n]) for n in range(1, len(parts) + 1)}
    for c in _candidates(path, cfg):
        c = c.rstrip("/") or "/"
        if c == base or (base + "/").startswith(c if c.endswith("/") else c + "/"):
            return c
        if c.startswith(base + "/") and c[len(base) + 1 :] in parents:
            return c[len(base) + 1 :]
    return None


def _segments(command: str) -> list[str]:
    """The command's segments split at `&&`, `||`, `;`, `|` and newlines, then also at a single `&`
    (both splits are kept, so a split only adds segments)."""
    first = re.split(r"&&|\|\||[;|\n]", command)
    known = set(first)
    more = [seg for seg in re.split(r"&&|\|\||[;|&\n]", command) if seg not in known]
    return first + more


def _write_targets(segment: str) -> list[str]:
    """The words a write segment may change: redirect targets, and the words after tee, sed -i,
    rm, mv, cp, truncate or ln. Running `./hub doctor > out` names ./hub, but does not write it."""
    targets = [t for target in WRITE_TARGET.findall(segment) for t in _tokens(target)]
    args = WRITE_ARGS.search(segment)
    return targets + (_tokens(args.group(1)) if args else [])


def _tokens(segment: str) -> list[str]:
    """The segment's words that may name a path, options dropped: each with its outer quotes stripped,
    and again with every quote and backslash removed (`h"ub".json`, `hub\\.json`). Words split at
    blanks and redirections, and again also at parentheses and backticks (both kept: only adds words)."""
    toks: list[str] = []
    seen: set[str] = set()
    for word in dict.fromkeys([*re.split(r"[\s<>]+", segment), *re.split(r"[\s<>()`]+", segment)]):
        for tok in (word.strip("'\""), re.sub(r"['\"\\\\]", "", word)):
            if tok and not tok.startswith("-") and tok not in seen:
                seen.add(tok)
                toks.append(tok)
    return toks


DENY_PATH_REASON = "{} is under guard.deny_paths `{}` (hub.json); agents neither read nor change it"
GUARD_PARENT_REASON = "{} holds the hub's guard files ({}); removing or moving it changes the guard, confirm first"
GUARD_FILE_REASON = ("{} is the hub's own guard or config ({}): hooks, the project guard extension, settings, "
                     "hub.lock, hub.json and the hub/agent launchers change only with the user's confirmation")
INFRA_MARKER_REASON = "this command matches guard.infra.prod_markers `{}` (hub.json): production infrastructure is human-only"
INFRA_UNKNOWN_REASON = ("{}: environment not recognised by guard.infra.allow (hub.json); put the environment on this "
                        "command, e.g. `--profile <env>` or an `AWS_PROFILE=<env> ` prefix (an exported or inherited "
                        "one does not count)")
INFRA_ASK_REASON = "`{} {}` changes infrastructure on an allowed environment; confirm first"
INFRA_CONFIG_REASON = "{} (hub.json) cannot be used ({}); infrastructure commands are denied until it is fixed"
INFRA_SIMPLE_REASON = "`{}` is a shell construct guard.infra does not check; confirm this infrastructure command first"
INFRA_VALUE_CAP = 100  # characters of a value from hub.json or the command in an infra reason
LEGACY_INFRA = re.compile(
    r"\bterraform\s+(apply|destroy|import)\b|\baws\s+\S+|\bpulumi\s+(up|destroy)\b|\bkubectl\s+(apply|delete)\b"
    r"|\bcdk\s+(deploy|destroy)\b|\b(terraform|aws|pulumi|kubectl|cdk)(\d*[<>]|&>)"
)


def _escaped(text: str) -> str:
    """text with quotes, backslashes, control characters and non-ASCII as JSON escapes: a location
    read from hub.json goes into a reason as plain text."""
    return json.dumps(text)[1:-1]


def _printable(text: str) -> str:
    """text with control characters and non-ASCII as JSON escapes (as _escaped), printable ASCII
    kept: a pattern stays as written."""
    return "".join(ch if " " <= ch <= "~" else _escaped(ch) for ch in text)


def _infra_value(text: str, escape: Callable[[str], str] = _escaped) -> str:
    """text escaped, at most INFRA_VALUE_CAP characters ("..." marks a cut), so an infra reason
    stays one short line whatever hub.json or the command holds."""
    shown = escape(text[:INFRA_VALUE_CAP])
    if len(text) > INFRA_VALUE_CAP or len(shown) > INFRA_VALUE_CAP:
        return shown[:INFRA_VALUE_CAP - 3] + "..."
    return shown


def _infra_compiled(key: str, patterns: tuple[str, ...]) -> tuple[list[re.Pattern[str]], Verdict]:
    """(each guard.infra.<key> pattern compiled, None), or ([], the deny naming the first one this
    interpreter cannot compile)."""
    compiled = []
    for index, pattern in enumerate(patterns):
        try:
            compiled.append(re.compile(pattern))
        except (re.error, OverflowError, RecursionError) as error:
            location = f"guard.infra.{key}[{index}]"
            return [], ("deny", INFRA_CONFIG_REASON.format(location, _infra_value(f"not a Python regex here: {error}", _printable)))
    return compiled, None


def _infra_shell(text: str) -> tuple[list[int], int, int, bool]:
    """How bash reads text's quotes, comments and backslashes: (where each backslash-newline it
    joins starts: after an odd run of backslashes, outside a comment, '…' and $'…'; where its first
    comment starts, or -1; where its first `#` inside a quote at a word start is, or -1; whether a
    quote is left open)."""
    joins: list[int] = []
    quote, comment, quoted, pos = "", -1, -1, 0
    while True:
        found = INFRA_LEX.search(text, pos)
        if not found:
            return joins, comment, quoted, quote not in ("", "#")
        at, char = found.start(), found.group(0)
        pos = at + 1
        word_start = at == 0 or bool(INFRA_WORD_BREAK.match(text, at - 1))
        if quote == "#":
            quote = "" if char == "\n" else quote
        elif quote == "'":
            quote = "" if char == "'" else quote
        elif quote == "$'":
            pos = at + 2 if char == "\\" else pos
            quote = "" if char == "'" else quote
        elif char == "\\":
            if text[at + 1:at + 2] == "\n":
                joins.append(at)
            pos = at + 2
        elif quote == '"':
            quote = "" if char == '"' else quote
        elif char == "$" and text[at + 1:at + 2] == "$":
            pos = at + 2
        elif char == "$" and text[at + 1:at + 2] == "'":
            quote, pos = "$'", at + 2
        elif char in "'\"":
            quote = char
        elif char == "#" and word_start:
            quote, comment = "#", at if comment < 0 else comment
        if char == "#" and word_start and quote not in ("", "#") and quoted < 0:
            quoted = at


def _infra_joined(cmd: str) -> str:
    """cmd with each backslash-newline bash joins removed (nothing put in its place, as bash does);
    any other newline stays a part boundary."""
    if "\\\n" not in cmd:
        return cmd
    joins = _infra_shell(cmd)[0]
    starts = [0] + [at + 2 for at in joins]
    return "".join(cmd[start:end] for start, end in zip(starts, joins + [len(cmd)]))


def _uncommented(text: str) -> str:
    """text up to its first comment (an unquoted `#` at the start or after a blank or operator);
    `'…'`, `"…"` and `$'…'` (where a backslash escapes) are quotes, `$$` is a token. When the quotes
    do not close, up to its first such `#` quoted or not (when unsure, cut)."""
    if "#" not in text:
        return text
    _, comment, quoted, unclosed = _infra_shell(text)
    if comment >= 0:
        return text[:comment]
    return text[:quoted] if unclosed and quoted >= 0 else text


def _quote_in_word(text: str) -> tuple[int, str] | None:
    """(where, the word) of the first quote that opens or closes inside a word (`a''b`, `"a"b`),
    or that never closes; None when every quote spans whole words."""
    quote, opened, pos = "", 0, 0
    while True:
        found = INFRA_QUOTE_NEXT[quote].search(text, pos)
        if not found:
            return (opened, _word_at(text, opened)) if quote else None
        at, pos = found.start(), found.start() + 1
        side = text[at + 1:at + 2] if quote else text[at - 1:at]
        if side and not INFRA_WORD_BREAK.match(side):
            return at, _word_at(text, at)
        quote, opened = ("", opened) if quote else (found.group(0), at)


def _word_at(text: str, at: int) -> str:
    """The word around text[at] (blanks and operators end it), at most INFRA_VALUE_CAP characters
    before it."""
    head = INFRA_WORD_TAIL.search(text[max(0, at - INFRA_VALUE_CAP):at])
    tail = INFRA_WORD_PIECE.match(text, at + 1)
    return (head.group(0) if head else "") + text[at] + (tail.group(0) if tail else "")


def _infra_unmodelled(cmd: str) -> str | None:
    """The leftmost construct of cmd the infra rule does not model (E21), or None for a simple
    command."""
    found = []
    token = INFRA_UNMODELLED.search(cmd)
    if token:
        found.append((token.start(), token.group(0)))
    dot = INFRA_DOT.search(cmd)
    if dot:
        found.append((dot.start(1), "."))
    shell = INFRA_SHELL_WORD.search(cmd)
    flag = INFRA_SHELL_C.search(cmd, shell.end()) if shell else None
    if shell and flag:
        found.append((shell.start(), f"{shell.group(0)} {flag.group(0)}"))
    quoted = _quote_in_word(cmd)
    if quoted:
        found.append(quoted)
    return min(found)[1] if found else None


class _Evidence:
    """A part's or call's text without its comment, and whether its `--client` and `-backend=false`
    flags hold (each searched at most once)."""

    def __init__(self, text: str) -> None:
        self.text = _uncommented(text)
        self.flags: dict[str, bool] = {}

    def has(self, flag: tuple[re.Pattern[str], re.Pattern[str], re.Pattern[str]]) -> bool:
        needed, keeps, word = flag
        if word.pattern not in self.flags:
            words, kept = list(word.finditer(self.text)), list(keeps.finditer(self.text))
            self.flags[word.pattern] = bool(
                needed.search(self.text) and words and kept
                and kept[-1].start() <= words[-1].start() < kept[-1].end())
        return self.flags[word.pattern]


def _infra_local(text: str, mention: re.Match[str], evidence: _Evidence, end: int) -> bool:
    """Whether a covered-tool mention is a local-only form (D5): its words right after the tool,
    before end, the end of its call (a glued redirection, or blanks up to end, never are)."""
    tool, at = mention.group(1), mention.start(2)
    if not 0 <= at < end:
        return False
    if tool == "kubectl" and INFRA_KUBECTL_VERSION.match(text, at):
        return evidence.has(INFRA_CLIENT)
    if tool == "terraform" and INFRA_TERRAFORM_INIT.match(text, at):
        return evidence.has(INFRA_BACKEND)
    local = INFRA_LOCAL.get(tool)
    return bool(INFRA_LOCAL_ANY.match(text, at) or (local and local.match(text, at)))


def _infra_unknown(text: str, mentions: list[re.Match[str]], allow: list[re.Pattern[str]]) -> tuple[bool, str | None]:
    """(whether text, without its comment, matches an allow pattern; the tool a deny names: its
    first mention when it is not allowed and some mention is not a local form, else None)."""
    if not mentions:
        return False, None
    evidence = _Evidence(text)
    if any(pattern.search(evidence.text) for pattern in allow):
        return True, None
    if all(_infra_local(text, mention, evidence, len(text)) for mention in mentions):
        return False, None
    return False, mentions[0].group(1)


def _infra_calls(part: str, mentions: list[re.Match[str]], allow: list[re.Pattern[str]]) -> tuple[bool, str | None]:
    """Each mention of the part checked against the call that holds it, found by its offset: (whether
    such a call matches an allow pattern; the tool a deny names: the first mention of the first
    call where a mention is neither allowed nor a local form, else None)."""
    starts = [0] + [found.end() for found in INFRA_CALL.finditer(part)]
    calls: dict[int, tuple[bool, _Evidence, str]] = {}
    allowed = False
    for mention in mentions:
        index = bisect.bisect_right(starts, mention.start()) - 1
        end = starts[index + 1] - 1 if index + 1 < len(starts) else len(part)
        if index not in calls:
            evidence = _Evidence(part[starts[index]:end])
            calls[index] = (any(pattern.search(evidence.text) for pattern in allow), evidence, mention.group(1))
        call_allowed, evidence, first = calls[index]
        allowed = allowed or call_allowed
        if not call_allowed and not _infra_local(part, mention, evidence, end):
            return allowed, first
    return allowed, None


def _infra_ask(part: str) -> Verdict:
    """The ask for the first ask verb after a tool's first mention in an allowed part, if any:
    one search per distinct tool, from its first mention."""
    seen = set()
    for mention in INFRA_TOOL.finditer(part):
        tool = mention.group(1)
        if tool in seen:
            continue
        seen.add(tool)
        verb = INFRA_ASK_VERBS[tool].search(part, mention.end(1))
        if verb:
            return "ask", INFRA_ASK_REASON.format(tool, _infra_value(" ".join(verb.split())))
        if len(seen) == len(INFRA_TOOLS):
            break
    return None


def check_infra(cmd: str, cfg: Config) -> Verdict:
    """The infra rule on the command as given. Without guard.infra: the fixed rule (a deny or None),
    on the command with every backslash-newline a blank. With it, on the command with only the
    backslash-newlines bash joins joined, and only when a part names a covered tool: an unusable
    guard.infra or pattern denies; a production marker anywhere in the command denies; then per
    part, in order: the part, then the call that holds each tool mention, must match an allow
    pattern (text after an unquoted ` #` does not count) or hold only local-only forms, else deny;
    a part where something matched an allow pattern asks on its first ask verb; and what would
    pass asks when the command is not simple (E21)."""
    infra = cfg.infra
    spaced = cmd.replace("\\\n", " ")
    if infra is None:
        if LEGACY_INFRA.search(spaced):
            return "deny", "infrastructure commands (terraform/aws/pulumi/kubectl) are human-only"
        return None
    c = _infra_joined(cmd)
    parts = [part for part in INFRA_PART.split(c) if INFRA_TOOL.search(part)]
    if not parts:
        return None
    if infra.problem:
        return "deny", INFRA_CONFIG_REASON.format(_infra_value(infra.problem), "malformed")
    allow, failed = _infra_compiled("allow", infra.allow)
    markers, failed_marker = _infra_compiled("prod_markers", infra.prod_markers)
    if failed or failed_marker:
        return failed or failed_marker
    for pattern in markers:
        if pattern.search(c) or pattern.search(spaced):
            return "deny", INFRA_MARKER_REASON.format(_infra_value(pattern.pattern, _printable))
    verdict: Verdict = None
    for part in parts:
        mentions = list(INFRA_TOOL.finditer(part))
        allowed, tool = _infra_unknown(part, mentions, allow)
        if not tool and INFRA_CALL.search(part):
            calls_allowed, tool = _infra_calls(part, mentions, allow)
            allowed = allowed or calls_allowed
        if tool:
            return "deny", INFRA_UNKNOWN_REASON.format(tool)
        if allowed and verdict is None:
            verdict = _infra_ask(part)
    construct = None if verdict else _infra_unmodelled(cmd)
    if construct:
        return "ask", INFRA_SIMPLE_REASON.format(_infra_value(construct))
    return verdict


def check_bash(cmd: str, cfg: Config | None = None) -> Verdict:
    cfg = cfg or Config()
    c = cmd.replace("\\\n", " ")
    # longest first, so release/2 is named before release
    branches = "|".join(re.escape(b) for b in sorted(cfg.protected_branches, key=lambda b: (-len(b), b)))
    if re.search(GIT + r"push\b[^;&|\n]*(\s--force\b|\s-[a-zA-Z]*f[a-zA-Z]*\b|\s--force-with-lease\b|\s--mirror\b|\s\+\S)", c):
        return "deny", "force-push is not allowed; push a new commit (or a merge) instead"
    push = re.search(GIT + rf"push\b[^;&|\n]*(\s(origin\s+)?(?P<plain>{branches})\b|:(refs/heads/)?(?P<ref>{branches})\b)", c)
    if push:
        return "deny", f"pushing to {push.group('plain') or push.group('ref')} is not allowed; open a PR from a {_branch_hint(cfg)} branch"
    if re.search(r"\b(curl|wget)\b[^|;&\n]*\|\s*(sudo\s+)?(ba|z|da)?sh\b", c):
        return "deny", "curl|sh is not allowed; download, inspect, then run explicitly"
    host = denied_host(c, cfg)
    if host:
        return "deny", f"{host} is in guard.deny_hosts (hub.json); agents do not reach it. Use fixtures or a sandbox endpoint"
    if re.search(r"\bdocker\s+volume\s+(rm|prune)\b|\bdocker\s+compose\b[^;&|\n]*\bdown\b[^;&|\n]*\s-v\b", c):
        return "deny", "removing docker volumes deletes local data (databases, caches); a human does this"
    infra = check_infra(cmd, cfg)
    if infra and infra[0] == "deny":
        return infra
    return tighten(infra, _after_infra(c, cfg))


def _after_infra(c: str, cfg: Config) -> Verdict:
    """check_bash's rules after the infra rule (secrets, attribution, claude/ branches, .git,
    deny_paths, guard files, tests, brain, ask_before_edit): an infra ask or allow does not end the
    check, so a later deny wins and a later ask keeps the infra reason."""
    for seg in re.split(r"&&|\|\||[;|\n]", c):
        words = seg.split()
        if not words or words[0] in SAFE_ON_SECRETS:
            continue
        for m in SECRET_TOKEN.finditer(seg):
            tok = m.group(0).lstrip("<").strip("'\"")
            if _secret_path(tok):
                return "deny", f"reading secret file {tok} is not allowed (any command, not just cat); reference the variable name instead"
    if re.search(r"\bgit\s+(commit|tag)\b", c) and AI_ATTRIBUTION.search(c):
        return "deny", "commits carry no AI attribution (no Co-Authored-By AI, no 'Generated with', no 🤖)"
    if re.search(r"\bgh\s+pr\s+(create|edit)\b", c) and AI_ATTRIBUTION.search(c):
        return "deny", "PR text carries no AI attribution"
    if re.search(r"\b(checkout\s+-b|switch\s+-c|branch(\s+-\w+)*|worktree\s+add\b[^;&|\n]*-b)\s+['\"]?claude/", c):
        return "deny", f"branches are {_branch_hint(cfg)}, never claude/..."
    if re.search(r"\b(rm|mv|cp|ln|truncate)\b[^;&|\n]*(^|[\s/'\"])\.git(/|\s|$|['\"])", c) or re.search(r">>?\s*(\S*/)?\.git(/|\s|$)", c):
        return "deny", ".git is git's own state (a worktree's .git file links it to the repo); use git commands, never edit it directly"
    if cfg.deny_paths:
        for seg in _segments(c):
            for tok in _tokens(seg):
                pat = denied_path(tok, cfg)
                if pat:
                    return "deny", DENY_PATH_REASON.format(tok, pat)
    for seg in _segments(c):
        if BASH_WRITE.search(seg):
            for tok in _tokens(seg):
                rel = guard_file(tok, cfg, launchers=False)
                if rel:
                    return "ask", GUARD_FILE_REASON.format(tok, rel)
            for tok in _write_targets(seg):
                rel = guard_file(tok, cfg)
                if rel:
                    return "ask", GUARD_FILE_REASON.format(tok, rel)
        if re.search(r"\b(rm|mv)\b", seg):
            for tok in _tokens(seg):
                held = guard_parent(tok, cfg)
                if held is not None:
                    return "ask", GUARD_PARENT_REASON.format(tok, held or "the hub")
    if re.search(r"\b(rm|mv|truncate)\b[^;&|\n]*\s" + TEST_PATH, c) or re.search(r"\bsed\s+(-\w*i\w*|--in-place)\b[^;&|\n]*\s" + TEST_PATH, c):
        return "ask", "deleting or sed-editing tests from Bash bypasses the assertion guard; use Edit, or confirm this is intended"
    if re.search(r"(>>?|\btee\b(\s+-a)?|\bsed\s+-\w*i\w*|\b(rm|mv|cp)\b)[^;&|\n]*\bbrain/(?!(now\.md|journal/|_inbox/|auto/|features/))\S+", c):
        return "ask", "brain/ is curated: agents write only now.md, journal/, _inbox/, auto/ and features/; propose via /learn or confirm"
    if cfg.ask_before_edit:
        for seg in _segments(c):
            if not BASH_WRITE.search(seg):
                continue
            for tok in _tokens(seg):
                pat = protected(tok, cfg)
                if pat:
                    return "ask", f"{tok} matches guard.ask_before_edit `{pat}` (hub.json); confirm this change is intended"
    return None


def _assert_count(s: str) -> int:
    return len(re.findall(r"\bassert\b|\bexpect\(|\bpytest\.raises\b|\.assert_\w+\(|\.assert[A-Z]\w*\(|\bself\.fail\(", s or ""))


def _brain_rel(path: str, cfg: Config) -> str | None:
    """Path inside the hub's brain/ (main checkout or a hub worktree), relative to brain/."""
    if cfg.hub:
        m = re.search(re.escape(cfg.hub.name) + r"/(?:\.claude/worktrees/[^/]+/)?brain/(.+)$", path)
        if m:
            return m.group(1)
    m = re.search(r"^(.*)/brain/(.+)$", path)
    if m and os.path.isfile(os.path.join(m.group(1), "hub.json")):
        return m.group(2)
    m = re.search(r"^brain/(.+)$", path)
    if m and os.path.isdir("brain"):
        return m.group(1)
    return None


def check_file(tool: str, ti: dict, cfg: Config | None = None) -> Verdict:
    cfg = cfg or Config()
    if tool == "WebFetch":
        host = denied_host(_str(ti.get("url")), cfg)
        return ("deny", f"{host} is in guard.deny_hosts (hub.json); agents do not reach it") if host else None
    path = _str(ti.get("file_path")) or _str(ti.get("notebook_path")) or _str(ti.get("path"))
    glob = _str(ti.get("glob"))
    if tool == "Grep" and glob and re.search(r"(^|[/*{,])\.env\b", glob) and ".example" not in glob:
        return "deny", "Grep over .env files may print secrets; reference variable names instead"
    targets = [path] if path else []
    if tool == "Glob" and _str(ti.get("pattern")):
        targets.append(os.path.join(path, _str(ti.get("pattern"))) if path else _str(ti.get("pattern")))
    for target in targets if cfg.deny_paths else []:
        pat = denied_path(target, cfg)
        if pat:
            return "deny", DENY_PATH_REASON.format(target, pat)
    if not path:
        return None
    if _secret_path(path):
        return "deny", f"{os.path.basename(path)} may hold secrets; reference variable names instead of reading it"
    if tool in ("Read", "Grep", "Glob"):
        return None
    if re.search(r"(^|/)\.git(/|$)", path):
        return "deny", ".git is git's own state (a worktree's .git file links it to the repo); use git commands, never edit it directly"
    rel = guard_file(path, cfg)
    if rel:
        return "ask", GUARD_FILE_REASON.format(path, rel)
    if re.search(r"(^|/)(tests?|__tests__)/|\.(test|spec)\.[jt]sx?$|/test_[^/]+\.py$", path):
        if tool == "Edit":
            removed = _assert_count(_str(ti.get("old_string"))) - _assert_count(_str(ti.get("new_string")))
        elif tool == "MultiEdit":
            removed = sum(_assert_count(_str(e.get("old_string"))) - _assert_count(_str(e.get("new_string"))) for e in _edits(ti))
        elif tool == "Write" and os.path.exists(path):
            removed = _assert_count(_read_text(path)) - _assert_count(_str(ti.get("content")))
        else:
            removed = 0
        if removed > 0:
            return "ask", f"this edit removes {removed} assertion(s) from a test; acceptance tests are a contract, confirm first"
        before = _str(ti.get("old_string")) if tool == "Edit" else "".join(_str(e.get("old_string")) for e in _edits(ti)) if tool == "MultiEdit" else ""
        if tool == "Write" and os.path.exists(path):
            before = _read_text(path)
        after = _str(ti.get("new_string")) if tool == "Edit" else "".join(_str(e.get("new_string")) for e in _edits(ti)) if tool == "MultiEdit" else _str(ti.get("content"))
        if len(SKIP_MARKERS.findall(after or "")) > len(SKIP_MARKERS.findall(before or "")):
            return "ask", "this edit adds a skip/xfail/quarantine/fixme marker to a test; that weakens the suite, confirm first"
    pat = protected(path, cfg)
    if pat:
        return "ask", f"{path} matches guard.ask_before_edit `{pat}` (hub.json): plan and approval first; confirm this change is intended"
    rel = _brain_rel(path, cfg)
    if rel is not None and not re.match(r"(now\.md|journal/|_inbox/|auto/|features/)", rel):
        return "ask", "brain/ is curated: agents write only now.md, journal/, _inbox/, auto/ and features/; propose via /learn or confirm"
    return None


FILE_TOOLS = ("Read", "Grep", "Glob", "Edit", "Write", "MultiEdit", "NotebookEdit", "WebFetch")
EXTENSION_TIMEOUT = 3  # seconds, inside the guard's own 10 s hook timeout (spec Q-5)
RUNNER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "project_guard_runner.py")
STRICTNESS = {None: 0, "ask": 1, "deny": 2}
EXTENSION_REASON = "project guard: {}"
EXTENSION_NAME = "project_guard.py"
REASON_CAP = 300  # characters of an extension's reason or of a failure's stderr line
STDERR_TAIL = 4096  # bytes of the runner's stderr that are read back


def decide(data: dict, cfg: Config) -> Verdict:
    """The base verdict for one PreToolUse event: pure, no output."""
    tool, ti = _str(data.get("tool_name")), data.get("tool_input")
    if not isinstance(ti, dict):
        ti = {}
    if tool == "Bash":
        return check_bash(_str(ti.get("command")), cfg)
    if tool in FILE_TOOLS:
        return check_file(tool, ti, cfg)
    return None


def _one_line(text: str) -> str:
    """text on one line (whitespace runs become one space), capped at REASON_CAP characters."""
    return " ".join(text.split())[:REASON_CAP]


def _named(cfg: Config) -> bool:
    """Whether the hook root's hub.json names its project: the reader falls back to the folder's
    name (then "hub") when the file is unreadable or has no project.name."""
    root = str(cfg.root).rstrip("/")
    return cfg.root_project not in (os.path.basename(root), "hub")


def extension_file(cfg: Config) -> str | None:
    """plugin/<project>/hooks/project_guard.py of the hub holding this file, when it exists: never
    from $CLAUDE_PROJECT_DIR, $HUB_CONFIG, the cwd or the tool input; none in the plugin cache.
    When that hub.json names no project, the only plugin/*/hooks/project_guard.py there, if one."""
    if cfg.root is None:
        return None
    project = cfg.root_project
    if project not in ("", ".", "..") and "/" not in project and "\\" not in project:
        path = os.path.join(str(cfg.root), "plugin", project, "hooks", EXTENSION_NAME)
        if os.path.lexists(path):
            return path
    if _named(cfg):
        return None
    pattern = os.path.join(glob.escape(str(cfg.root)), "plugin", "*", "hooks", EXTENSION_NAME)
    found = [p for p in sorted(glob.glob(pattern)) if p.split(os.sep)[-3] != "hub-workflow"]
    return found[0] if len(found) == 1 else None


def _unusable(path: str, cfg: Config) -> str | None:
    """Why the extension file cannot run: it resolves (links followed) outside the hook root, or
    to no file; None when it is a file inside the root."""
    root = os.path.realpath(str(cfg.root)).rstrip(os.sep) + os.sep
    real = os.path.realpath(path)
    if not real.startswith(root):
        return "extension resolves outside the hub"
    return None if os.path.isfile(real) else "extension is not a file"


def _extension_cause(code: int, stdout: bytes, stderr: str) -> str | None:
    """Why the runner's answer is unusable, or None when it is null or a valid verdict."""
    if code != 0:
        lines = stderr.strip().splitlines()
        return f"exit {code}" + (f" ({_one_line(lines[-1])})" if lines else "")
    try:
        answer = json.loads(stdout.decode("utf-8").strip())
    except ValueError:
        return "its output is not one JSON value"
    if answer is None:
        return None
    if (
        isinstance(answer, dict)
        and set(answer) == {"verdict", "reason"}
        and answer["verdict"] in ("ask", "deny")
        and isinstance(answer["reason"], str)
    ):
        return None
    return f"unexpected answer {json.dumps(answer)[:REASON_CAP]}"


def _failed(cause: str) -> tuple[Verdict, bool]:
    return ("ask", EXTENSION_REASON.format(f"{cause}; confirm")), True


def _tail(fh: IO[bytes]) -> str:
    """The last STDERR_TAIL bytes of the runner's stderr file, as text."""
    fh.seek(0, os.SEEK_END)
    fh.seek(max(0, fh.tell() - STDERR_TAIL))
    return fh.read().decode("utf-8", "replace")


def run_extension(path: str, data: dict, cfg: Config) -> tuple[Verdict, bool]:
    """(the extension's verdict on the event, whether it failed). A failure is an ask naming the
    cause. The runner gets its own session, so a timeout kills every process it started."""
    unusable = _unusable(path, cfg)
    if unusable:
        return _failed(unusable)
    hub_json = os.path.join(str(cfg.root), "hub.json")
    with tempfile.TemporaryFile() as err:
        try:
            proc = subprocess.Popen(
                [sys.executable, RUNNER, path, hub_json],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=err,
                start_new_session=True,
            )
        except (OSError, ValueError) as error:
            return _failed(f"could not start ({type(error).__name__})")
        try:
            stdout, _ = proc.communicate(json.dumps(data).encode("utf-8"), timeout=EXTENSION_TIMEOUT)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                proc.communicate(timeout=1)
            except subprocess.TimeoutExpired:
                proc.kill()
            return _failed(f"timed out after {EXTENSION_TIMEOUT} s")
        cause = _extension_cause(proc.returncode, stdout, _tail(err))
    if cause:
        return _failed(cause)
    answer = json.loads(stdout.decode("utf-8").strip())
    if answer is None:
        return None, False
    return (answer["verdict"], EXTENSION_REASON.format(_one_line(answer["reason"]))), False


def tighten(base: Verdict, extra: Verdict, failed: bool = False) -> Verdict:
    """The stricter verdict (none < ask < deny); on a tie the base one, with a failure's cause
    added to its reason."""
    if STRICTNESS[extra[0] if extra else None] > STRICTNESS[base[0] if base else None]:
        return extra
    if failed and base and extra:
        return base[0], f"{base[1]}; {extra[1]}"
    return base


# The rule id the control plane records for a verdict, read from its reason: the first pattern that
# matches (re.search). A combined reason (a base ask with an extension failure) is the base rule's.
RULE_IDS = (
    ("force_push", re.compile(r"^force-push is not allowed")),
    ("push_protected_branch", re.compile(r"^pushing to \S+ is not allowed")),
    ("curl_pipe_shell", re.compile(r"^curl\|sh is not allowed")),
    ("docker_volumes", re.compile(r"^removing docker volumes")),
    ("infra_commands", re.compile(r"^infrastructure commands")),
    ("secret_read", re.compile(r"^reading secret file ")),
    ("ai_attribution", re.compile(r"^(commits|PR text) carr(y|ies) no AI attribution")),
    ("agent_branch", re.compile(r"^branches are \S*, never claude/")),
    ("git_internals", re.compile(r"^\.git is git's own state")),
    ("test_bash_edit", re.compile(r"^deleting or sed-editing tests")),
    ("brain_curated", re.compile(r"^brain/ is curated")),
    ("assertions_removed", re.compile(r"^this edit removes \d+ assertion")),
    ("skip_marker", re.compile(r"^this edit adds a skip")),
    ("secret_file", re.compile(r"^(\S.* may hold secrets|Grep over \.env files)")),
    ("project_guard", re.compile(r"^project guard: ")),
    ("deny_hosts", re.compile(r" is in guard\.deny_hosts \(hub\.json\)")),
    ("deny_paths", re.compile(r" is under guard\.deny_paths `")),
    ("guard_files", re.compile(r" is the hub's own guard or config \(")),
    ("guard_parent", re.compile(r" holds the hub's guard files \(")),
    ("ask_before_edit", re.compile(r" matches guard\.ask_before_edit `")),
)


def rule_of(reason: str) -> str | None:
    """The rule id of a verdict's reason (RULE_IDS), or None when no pattern matches."""
    for rule, pattern in RULE_IDS:
        if pattern.search(reason):
            return rule
    return None


def record(data: dict, decision: str, reason: str) -> None:
    """Send the printed verdict to the control plane; never raises, never prints."""
    if send_decision is None:
        return
    try:
        sys.stdout.flush()
        send_decision(data, {"by": "guard", "kind": decision, "rule": rule_of(reason)})
    except Exception:
        pass


def main() -> None:
    data = read_input()
    tool = data.get("tool_name")
    if tool != "Bash" and tool not in FILE_TOOLS:
        return
    cfg = load_config(data.get("cwd"))
    verdict = decide(data, cfg)
    if verdict is None or verdict[0] != "deny":  # a deny is final: the extension never runs
        path = extension_file(cfg)
        if path:
            extra, failed = run_extension(path, data, cfg)
            verdict = tighten(verdict, extra, failed)
    if verdict:
        decision, reason = verdict
        emit({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": decision,
                                     "permissionDecisionReason": f"[hub guard] {reason}"}})
        record(data, decision, reason)


def ask_on_error(kind: str) -> None:
    """A guard that could not check a call asks: never an allow by accident (fail open, AC-4.11)."""
    emit({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "ask",
                                 "permissionDecisionReason": f"[hub guard] could not check this call ({kind}); confirm"}})


if __name__ == "__main__":
    run_hook(main, ask_on_error)
