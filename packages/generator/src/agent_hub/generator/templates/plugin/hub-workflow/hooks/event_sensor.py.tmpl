#!/usr/bin/env python3
"""Hook sensor: send each Claude Code hook input to the local control plane (`hub web`).

Registered for ten events (SessionStart, UserPromptSubmit, PostToolUse, PostToolUseFailure,
Notification, Stop, SubagentStart, SubagentStop, PreCompact, SessionEnd); on PreToolUse,
pre_tool_use.py imports it and sends the input after the guard's verdict, the same way. It reads
the input (at most MAX_STDIN bytes) and reduces what would carry content (reduce_hook): the
prompt becomes prompt_chars and prompt_slash_command (its leading /name, if any); a Write's
content, an Edit's or a MultiEdit edit's old_string and new_string become <key>_lines (line counts;
a Write under brain/_inbox/ keeps its first markdown heading as content_heading); tool_response
becomes tool_response_bytes. It then replaces every string longer than MAX_STRING_BYTES (UTF-8)
with {"_omitted_bytes": n}, wraps it in a v1 envelope
{v, project, repo, run, step, attempt, sent_at, hook} and POSTs it to
<AGENT_HUB_WEB_URL, else http://127.0.0.1:7420>/api/v1/events/hooks within TIMEOUT seconds.
project is the hub's project (hub.json); repo the hub.json repo whose checkout or worktree holds
the input's cwd, else null; run, step and attempt come from AGENT_HUB_RUN_ID, AGENT_HUB_STEP and
AGENT_HUB_ATTEMPT (set by `hub run`), each null when it is out of bounds. A URL that is not plain
http to 127.0.0.1, [::1] or localhost (no user, path or query) turns the sensor off: no socket
is opened. An envelope over MAX_BODY_BYTES, an input that is not a JSON object, or no hub found
sends nothing. The sensor never prints, never decides anything, and exits 0 whatever happens.
The guard and the Stop gate send their decisions through send_decision (fail open as well).

An envelope the server did not take (nothing listens, no answer in time, no time left, or a 5xx
answer) is appended as one line, the exact POST body, to the spool: SPOOL_FILE in
$XDG_STATE_HOME/agent-hub, else $HOME/.local/state/agent-hub (each only when absolute; with
neither, nothing is kept), outside every hub and repo, since the command text in it is redacted
only when `hub web` or `hub collect --spool` imports it. The folder is made with mode 0700, the
files are 0600 and owned by this user, and neither is ever opened through a link. Every writer
holds an flock on SPOOL_LOCK (waiting at most SPOOL_LOCK_WAIT seconds, else the envelope is
dropped); a spool over MAX_SPOOL_BYTES loses its oldest lines down to SPOOL_KEEP_BYTES, and its
first line {"dropped": n} counts every line dropped so far (written to SPOOL_TRIM, then renamed).
"""

from __future__ import annotations

import json
import os
import re
import stat
import sys
import time
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath
from urllib.parse import urlsplit

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from hubhooks import load_config
except Exception:  # a partial install: the sensor sends nothing, silently
    load_config = None

MAX_STDIN = 16 * 1024 * 1024
MAX_STRING_BYTES = 65_536
MAX_BODY_BYTES = 1_048_576
TIMEOUT = 0.5  # seconds for the whole send: connect, request and answer
DEFAULT_URL = "http://127.0.0.1:7420"
URL_VARIABLE = "AGENT_HUB_WEB_URL"
HOOKS_PATH = "/api/v1/events/hooks"
LOOPBACK_HOSTS = ("127.0.0.1", "::1", "localhost")
MAX_STEP = 40
MAX_ATTEMPT = 99
# The spool of the envelopes the server did not take (see the module docstring).
SPOOL_FOLDER = "agent-hub"
SPOOL_FILE = "hook-spool.jsonl"
SPOOL_LOCK = "hook-spool.lock"
SPOOL_TRIM = "hook-spool.trim"
MAX_SPOOL_BYTES = 8 * 1024 * 1024
SPOOL_KEEP_BYTES = 6 * 1024 * 1024
SPOOL_LOCK_WAIT = 0.2  # seconds
SPOOL_LOCK_RETRY = 0.005  # seconds between two tries of the lock
# Only a regular file the sensor opens is used; a FIFO swapped in cannot block the open.
OPEN_FLAGS = os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
# What reduce_hook keeps of content; the control plane's hook mapper reads these keys.
FILE_TOOLS = ("Write", "Edit", "MultiEdit")
STRING_KEYS = ("old_string", "new_string")
INBOX = ("brain", "_inbox")
# A prompt's slash command and a markdown heading, as the control plane reads them.
SLASH_COMMAND = re.compile(r"(?:<command-name>)?(/[A-Za-z0-9_.:\-]+)")
HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*#*\s*$", re.MULTILINE)


def endpoint() -> tuple[str, int] | None:
    """(host, port) of the event server, or None when the configured URL is not loopback http."""
    url = os.environ.get(URL_VARIABLE) or DEFAULT_URL
    try:
        parts = urlsplit(url)
        port = parts.port
    except ValueError:  # a port out of range or not a number
        return None
    if parts.scheme != "http" or parts.username is not None or parts.password is not None:
        return None
    if parts.path not in ("", "/") or parts.query or parts.fragment:
        return None
    host = parts.hostname
    if host not in LOOPBACK_HOSTS:
        return None
    return host, port if port is not None else 80


def omit_large(value: object) -> object:
    """value with each string longer than MAX_STRING_BYTES replaced by {"_omitted_bytes": n}."""
    if isinstance(value, str):
        size = len(value.encode("utf-8", "surrogatepass"))
        return {"_omitted_bytes": size} if size > MAX_STRING_BYTES else value
    if isinstance(value, dict):
        return {key: omit_large(item) for key, item in value.items()}
    if isinstance(value, list):
        return [omit_large(item) for item in value]
    return value


def line_count(text: str) -> int:
    """Lines in text; a last line without a newline counts."""
    if not text:
        return 0
    return text.count("\n") + (0 if text.endswith("\n") else 1)


def output_size(value: object) -> int | None:
    """The UTF-8 size of a tool's output (its compact JSON when not text); None when absent."""
    if value is None:
        return None
    try:
        text = value if isinstance(value, str) else json.dumps(value, separators=(",", ":"))
    except (TypeError, ValueError, RecursionError):
        return None
    return len(text.encode("utf-8", "replace"))


def in_inbox(path: object) -> bool:
    """Whether path names a file under a brain/_inbox/ folder."""
    if not isinstance(path, str):
        return False
    parts = PurePosixPath(path).parts
    return any(parts[i : i + 2] == INBOX for i in range(len(parts) - 2))


def reduce_strings(edit: dict) -> dict:
    """edit with old_string and new_string replaced by their line counts."""
    reduced = dict(edit)
    for key in STRING_KEYS:
        if key in reduced:
            value = reduced.pop(key)
            if isinstance(value, str):
                reduced[key + "_lines"] = line_count(value)
    return reduced


def reduce_tool_input(tool_input: dict) -> dict:
    """A Write, Edit or MultiEdit input with its content replaced by line counts."""
    reduced = reduce_strings(tool_input)
    if "content" in reduced:
        content = reduced.pop("content")
        if isinstance(content, str):
            reduced["content_lines"] = line_count(content)
            heading = HEADING.search(content) if in_inbox(reduced.get("file_path")) else None
            if heading is not None:
                reduced["content_heading"] = heading.group(1)
    edits = reduced.get("edits")
    if isinstance(edits, list):
        reduced["edits"] = [reduce_strings(e) if isinstance(e, dict) else e for e in edits]
    return reduced


def reduce_hook(hook: dict) -> dict:
    """hook without the bodies it may carry: the prompt, file content and the tool's output are
    replaced by their sizes (see the module docstring); every other key is kept."""
    reduced = dict(hook)
    if "prompt" in reduced:
        prompt = reduced.pop("prompt")
        if isinstance(prompt, str):
            reduced["prompt_chars"] = len(prompt)
            command = SLASH_COMMAND.match(prompt.lstrip())
            if command is not None:
                reduced["prompt_slash_command"] = command.group(1)
    if "tool_response" in reduced:
        size = output_size(reduced.pop("tool_response"))
        if size is not None:
            reduced["tool_response_bytes"] = size
    tool_input = reduced.get("tool_input")
    if reduced.get("tool_name") in FILE_TOOLS and isinstance(tool_input, dict):
        reduced["tool_input"] = reduce_tool_input(tool_input)
    return reduced


def run_fields() -> dict:
    """run, step and attempt from `hub run`'s variables; each None when absent or out of bounds."""
    run = os.environ.get("AGENT_HUB_RUN_ID", "")
    step = os.environ.get("AGENT_HUB_STEP", "")
    attempt = os.environ.get("AGENT_HUB_ATTEMPT", "")
    return {
        "run": run if re.fullmatch(r"[0-9a-f]{8,12}", run) else None,
        "step": step if 0 < len(step) <= MAX_STEP else None,
        "attempt": int(attempt) if re.fullmatch(r"[1-9][0-9]?", attempt) else None,
    }


def repo_of(cwd: object, cfg) -> str | None:
    """The hub.json repo whose main checkout (or one of its worktrees, which live inside it) holds
    cwd; None for the hub, any other folder, or no cwd."""
    if not isinstance(cwd, str) or not cwd or cfg.workspace is None:
        return None
    try:
        where = Path(cwd).resolve()
        workspace = Path(cfg.workspace).resolve()
    except (OSError, ValueError, RuntimeError):
        return None
    for name in cfg.repo_dirs:
        if not name or "/" in name or name in (".", ".."):
            continue
        home = workspace / name
        if where == home or home in where.parents:
            return name
    return None


def sent_at() -> str:
    now = datetime.now(timezone.utc)
    return now.strftime("%Y-%m-%dT%H:%M:%S.") + f"{now.microsecond // 1000:03d}Z"


def build_envelope(hook: dict, decision: dict | None = None) -> dict | None:
    """The v1 envelope of hook (reduced, then oversized strings omitted), or None when no hub is
    found."""
    if load_config is None:
        return None
    cwd = hook.get("cwd")
    cfg = load_config(cwd if isinstance(cwd, str) and cwd else None)
    if cfg.hub is None or not cfg.project_name:
        return None
    envelope = {
        "v": 1,
        "project": cfg.project_name,
        "repo": repo_of(cwd, cfg),
        **run_fields(),
        "sent_at": sent_at(),
        "hook": omit_large(reduce_hook(hook)),
    }
    if decision is not None:
        envelope["decision"] = decision
    return envelope


def post_envelope(envelope: dict, timeout: float = TIMEOUT) -> None:
    """POST envelope to the event server within timeout seconds; when the server does not take
    it, append it to the spool. Any failure is silent.

    With the sensor turned off (endpoint) or a body over MAX_BODY_BYTES nothing is sent or kept.
    With no time left (timeout 0 or less) nothing is sent and the envelope is spooled."""
    try:
        target = endpoint()
        if target is None:
            return
        body = json.dumps(envelope, allow_nan=False).encode("ascii")
        if len(body) > MAX_BODY_BYTES:
            return
        if not deliver(target, body, timeout):
            spool(body)
    except Exception:  # unencodable, or the spool failed: the sensor fails open
        return


def deliver(target: tuple[str, int], body: bytes, timeout: float) -> bool:
    """Whether the server answered body's POST within timeout seconds with a status under 500.

    The request is written on a plain socket as http.client wrote it (the same Host, the body's
    type and length), with Connection: close, and one read of at most 4 KiB takes the answer."""
    try:
        if timeout <= 0:
            return False
        deadline = time.monotonic() + timeout
        host, port = target
        # http.client's Host: an IPv6 address in brackets, and the port unless it is http's 80.
        name = f"[{host}]" if ":" in host else host
        authority = name if port == 80 else f"{name}:{port}"
        head = (
            f"POST {HOOKS_PATH} HTTP/1.1\r\nHost: {authority}\r\nContent-Type: application/json\r\n"
            f"Content-Length: {len(body)}\r\nConnection: close\r\n\r\n"
        )
        import socket  # here, not at the top: a hook that loads the sensor and sends nothing skips it

        with socket.create_connection(target, timeout=deadline - time.monotonic()) as connection:
            left = deadline - time.monotonic()
            if left <= 0:
                return False
            connection.settimeout(left)
            connection.sendall(head.encode("ascii") + body)
            left = deadline - time.monotonic()
            if left <= 0:
                return False
            connection.settimeout(left)
            answer = connection.recv(4096)
    except Exception:  # down, slow, refused: the envelope goes to the spool
        return False
    # "HTTP/1.1 503 ...": the status's first digit is the tenth byte.
    return answer.startswith(b"HTTP/") and answer[9:10] != b"5"


def spool_folder() -> str | None:
    """$XDG_STATE_HOME/agent-hub, else $HOME/.local/state/agent-hub, each only when absolute."""
    state = os.environ.get("XDG_STATE_HOME", "")
    if os.path.isabs(state):
        return os.path.join(state, SPOOL_FOLDER)
    home = os.environ.get("HOME", "")
    if os.path.isabs(home):
        return os.path.join(home, ".local", "state", SPOOL_FOLDER)
    return None


def spool(body: bytes) -> None:
    """Append body as one line to the spool, under its lock (see the module docstring)."""
    folder = spool_folder()
    if folder is None:
        return
    os.makedirs(folder, mode=0o700, exist_ok=True)
    directory = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | OPEN_FLAGS)
    try:
        info = os.fstat(directory)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            return
        import fcntl  # here, not at the top: only a spooled envelope takes the lock

        lock = open_private(directory, SPOOL_LOCK, os.O_RDWR | os.O_CREAT)
        try:
            if not take_lock(fcntl, lock):
                return
            if append_line(directory, body) > MAX_SPOOL_BYTES:
                trim(directory)
        finally:
            os.close(lock)  # releases the lock
    finally:
        os.close(directory)


def open_private(directory: int, name: str, flags: int) -> int:
    """name in the spool folder, opened with flags but never through a link: a regular file of
    this user, set to mode 0600 when it was not; OSError otherwise."""
    descriptor = os.open(name, flags | OPEN_FLAGS, 0o600, dir_fd=directory)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise OSError(f"{name}: not a regular file of this user")
        if stat.S_IMODE(info.st_mode) != 0o600:
            os.fchmod(descriptor, 0o600)
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor


def take_lock(fcntl, lock: int) -> bool:
    """Whether the exclusive lock on lock was taken within SPOOL_LOCK_WAIT seconds."""
    deadline = time.monotonic() + SPOOL_LOCK_WAIT
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            if time.monotonic() >= deadline:
                return False
            time.sleep(SPOOL_LOCK_RETRY)


def write_all(descriptor: int, data: bytes) -> None:
    written = 0
    while written < len(data):
        written += os.write(descriptor, data[written:])


def append_line(directory: int, body: bytes) -> int:
    """Append body and a newline to the spool; the spool's size after it."""
    descriptor = open_private(directory, SPOOL_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
    try:
        write_all(descriptor, body + b"\n")
        return os.fstat(descriptor).st_size
    finally:
        os.close(descriptor)


def dropped_count(line: bytes) -> int | None:
    """n when line is the spool's count {"dropped": n}, else None."""
    try:
        value = json.loads(line)
    except (ValueError, RecursionError):
        return None
    if not isinstance(value, dict) or list(value) != ["dropped"]:
        return None
    count = value["dropped"]
    is_count = isinstance(count, int) and not isinstance(count, bool) and count >= 0
    return count if is_count else None


def trim(directory: int) -> None:
    """Drop the spool's oldest lines until the rest holds at most SPOOL_KEEP_BYTES; the first
    line {"dropped": n} adds them to the count an earlier trim wrote."""
    descriptor = open_private(directory, SPOOL_FILE, os.O_RDONLY)
    try:
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
    finally:
        os.close(descriptor)
    lines = b"".join(chunks).split(b"\n")
    if lines and not lines[-1]:
        lines.pop()
    dropped = dropped_count(lines[0]) if lines else None
    if dropped is not None:
        lines = lines[1:]
    dropped = dropped or 0
    size = sum(len(line) + 1 for line in lines)
    first = 0
    while first < len(lines) and size > SPOOL_KEEP_BYTES:
        size -= len(lines[first]) + 1
        first += 1
    count = json.dumps({"dropped": dropped + first}).encode("ascii")
    trimmed = open_private(directory, SPOOL_TRIM, os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
    try:
        write_all(trimmed, b"\n".join([count, *lines[first:]]) + b"\n")
    finally:
        os.close(trimmed)
    os.replace(SPOOL_TRIM, SPOOL_FILE, src_dir_fd=directory, dst_dir_fd=directory)


def send_decision(hook: dict, decision: dict) -> None:
    """Send hook with the guard's or the Stop gate's decision; never raises, never prints."""
    try:
        envelope = build_envelope(hook, decision)
        if envelope is not None:
            post_envelope(envelope)
    except Exception:
        return


def parse_hook(raw: bytes) -> dict | None:
    """The hook input in raw, or None: over MAX_STDIN bytes, not UTF-8, not a JSON object."""
    if len(raw) > MAX_STDIN:
        return None
    try:
        data = json.loads(raw.decode("utf-8"))
    except (ValueError, RecursionError):
        return None
    return data if isinstance(data, dict) else None


def read_hook() -> dict | None:
    """The hook input on stdin, read up to one byte past MAX_STDIN (see parse_hook)."""
    return parse_hook(sys.stdin.buffer.read(MAX_STDIN + 1))


def main() -> None:
    hook = read_hook()
    if hook is None:
        return
    envelope = build_envelope(hook)
    if envelope is not None:
        post_envelope(envelope)


if __name__ == "__main__":
    try:
        main()
    except BaseException:  # noqa: B036 - nothing may reach the session: no output, exit 0
        pass
    sys.exit(0)
