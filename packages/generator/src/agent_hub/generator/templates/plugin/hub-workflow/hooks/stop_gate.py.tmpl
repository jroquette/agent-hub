#!/usr/bin/env python3
"""Stop: if this session changed code in a repo checkout/worktree listed in hub.json, run that repo's
`check_fast` command and block completion while it fails (feedback goes back to the agent). Repos with an
empty `check_fast` are skipped. Releases after 3 consecutive blocks to avoid loops. When checks pass and
files changed, remind about /handoff (never blocks). Each check runs in its own process group, killed when
the run ends (on a timeout, after a normal exit, and when the hook itself gets SIGTERM or SIGHUP), so no child
of a check outlives the gate; its output goes to a temp file, so a background child holding it open never
holds the gate up."""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from hubhooks import Config, checkouts, emit, git, load_config, read_input, run_hook
except Exception as error:  # a partial install: skip, never error the session
    print(f"[hub {os.path.splitext(os.path.basename(sys.argv[0] or 'hook'))[0]}] skipped: {type(error).__name__}", file=sys.stderr)
    sys.exit(0)

CODE_EXT = {".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".go", ".rs", ".java", ".kt", ".rb", ".sql",
            ".sh", ".toml", ".cfg", ".ini", ".yml", ".yaml"}
CODE_NAMES = {"Makefile", "package.json", "pyproject.toml", "go.mod", "Cargo.toml", "Dockerfile"}
MAX_BLOCKS = 3
TIMEOUT = 150
KILL_WAIT = 1
OUTPUT_TAIL = 3000


def session_start_time(data: dict) -> float:
    tp = data.get("transcript_path")
    try:
        return os.stat(tp).st_birthtime if tp and hasattr(os.stat(tp), "st_birthtime") else time.time() - 12 * 3600
    except OSError:
        return time.time() - 12 * 3600


def changed_code(top: Path, since: float) -> list[str]:
    out = []
    for line in git(["status", "--porcelain", "--untracked-files=all"], top).splitlines():
        rel = line[3:].split(" -> ")[-1].strip('"')
        p = top / rel
        if (p.suffix in CODE_EXT or p.name in CODE_NAMES) and p.exists() and p.stat().st_mtime >= since:
            out.append(rel)
    return out


def candidates(cfg: Config, cwd: Path) -> list[tuple[str, Path]]:
    """Checkouts to consider: the one containing cwd, else every checkout/worktree of every configured repo."""
    res = checkouts(cfg, cfg.repo_dirs)
    inside = [(r, t) for r, t in res if cwd == t or t in cwd.parents]
    return inside[-1:] if inside else res


def run_check(cmd: str, top: Path, limit: float) -> tuple[str, str]:
    """(status, output tail) of one check: "passed", "failed" (non-zero exit, could not start) or "killed"
    (still running after `limit` s). The output goes to an unnamed temp file and the gate waits for bash
    alone; then it kills the check's process group, whichever way the run ended."""
    env = dict(os.environ, NO_COLOR="1", FORCE_COLOR="0", CLICOLOR="0")
    try:
        out = tempfile.TemporaryFile()
    except OSError as e:
        return "failed", f"check_fast could not start: {e}"
    with out:
        exit_on_cancel()
        try:
            proc = subprocess.Popen(["bash", "-c", cmd], cwd=top, stdin=subprocess.DEVNULL, stdout=out,
                                    stderr=subprocess.STDOUT, env=env, start_new_session=True)
        except OSError as e:
            return "failed", f"check_fast could not start: {e}"
        code = None
        try:
            code = proc.wait(timeout=limit)
        except subprocess.TimeoutExpired:
            pass
        finally:  # an exception kills the group too
            stop(proc)
        if code is None:
            return "killed", ""
        return ("passed" if code == 0 else "failed"), output_tail(out)


def cancelled(signum: int, frame: object) -> None:
    raise SystemExit(0)  # unwinds through run_check's finally, past run_hook's `except Exception`: exit 0


def exit_on_cancel() -> None:
    """Make SIGTERM and SIGHUP (Claude Code cancelling the hook, or its timeout) exit cleanly, so the
    check's process group, in a session of its own, is killed on the way out."""
    for name in ("SIGTERM", "SIGHUP"):
        try:
            signal.signal(getattr(signal, name), cancelled)
        except (AttributeError, OSError, ValueError):  # no such signal here, or not the main thread
            pass


def stop(proc: subprocess.Popen) -> None:
    """Kill the check's whole process group: a leader exiting does not end its background children."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:  # ProcessLookupError: the group is already empty
        pass
    try:
        proc.wait(timeout=KILL_WAIT)
    except subprocess.TimeoutExpired:
        proc.kill()


def output_tail(out) -> str:
    """The last OUTPUT_TAIL characters of the check's output, ANSI colors removed."""
    try:
        size = out.seek(0, os.SEEK_END)
        out.seek(max(0, size - 4 * OUTPUT_TAIL))
        text = out.read().decode("utf-8", "replace")
    except OSError:
        return ""
    return re.sub(r"\x1b\[[0-9;]*m", "", text)[-OUTPUT_TAIL:]


def main() -> None:
    data = read_input()
    event_cwd = data.get("cwd")
    cwd = Path(event_cwd if isinstance(event_cwd, str) and event_cwd else os.getcwd()).resolve()
    cfg = load_config(cwd)
    if not cfg.workspace:
        return
    since = session_start_time(data)
    state = Path(tempfile.gettempdir()) / f"hub-stop-{data.get('session_id', 'x')}.json"
    try:
        saved = json.loads(state.read_text()) if state.exists() else {}
    except (OSError, ValueError):  # unreadable, not UTF-8 or not JSON: no block counted yet
        saved = {}
    blocks = saved.get("blocks") if isinstance(saved, dict) else None
    if not isinstance(blocks, int) or isinstance(blocks, bool):
        blocks = 0
    changed_any, failures, skipped = False, [], []
    for repo, top in candidates(cfg, cwd):
        files = changed_code(top, since)
        if not files:
            continue
        changed_any = True
        entry = cfg.repo(repo)
        cmd = (entry.check_fast if entry else "").strip()
        if not cmd:
            skipped.append(repo)
            continue
        status, out = run_check(cmd, top, TIMEOUT)
        if status == "killed":
            out = f"check_fast timed out (>{TIMEOUT} s)"
        if status != "passed":
            failures.append(f"## {repo} ({top.relative_to(cfg.workspace)}): `{cmd}` FAILED\nchanged: {', '.join(files[:8])}\n{out}")
    if failures and blocks < MAX_BLOCKS:
        try:
            state.write_text(json.dumps({"blocks": blocks + 1}))
        except OSError:  # without its counter the gate could never release: fail open, warn
            emit({"systemMessage": "[hub stop-gate] check_fast still failing and the block counter could not be saved; "
                                   "finishing anyway. Do not claim the work is done.\n\n" + "\n\n".join(failures)})
            return
        emit({"decision": "block", "reason": "[hub stop-gate] Fix these before finishing (check_fast must pass):\n\n" + "\n\n".join(failures)})
        return
    try:
        state.unlink()
    except OSError:  # absent, or not a file
        pass
    note = f" (no check_fast configured in hub.json for: {', '.join(sorted(set(skipped)))})" if skipped else ""
    if failures:
        emit({"systemMessage": f"[hub stop-gate] check_fast still failing after {MAX_BLOCKS} attempts; finishing anyway. Do not claim the work is done."})
    elif changed_any:
        emit({"systemMessage": f"[hub] code changed and check_fast is green{note}. If the work spans sessions, run /handoff."})


if __name__ == "__main__":
    run_hook(main)
