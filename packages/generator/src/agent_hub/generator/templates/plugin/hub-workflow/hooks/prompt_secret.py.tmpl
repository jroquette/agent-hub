#!/usr/bin/env python3
"""UserPromptSubmit: warn when a prompt looks like it holds a secret; never block it.

Input: Claude Code's UserPromptSubmit event on stdin, a JSON object whose ``prompt`` is a string.
Only the prompt's first ``PROMPT_LIMIT`` characters are scanned.

Checks, either of which is a match:
1. a secret's shape on a line (``stdlib_reader.secret_shaped``, the shared ``SECRET_SHAPES`` the
   guard also uses), searched in windows of at most ``SHAPE_WINDOW`` characters that overlap by
   ``SHAPE_OVERLAP``, so a long line costs time linear in its length;
2. a block of ``NAME_VALUE_MIN_LINES`` or more consecutive ``NAME=value`` lines (``NAME_VALUE_LINE``,
   ``export`` allowed), as pasted from an env file.

A file's name alone is not a match: a prompt that names ``.env.local`` or a key file holds no
secret.

Output: on a match, one JSON line ``{"systemMessage": WARNING}`` and exit 0; the warning never
quotes the prompt or the match. No match: no output, exit 0.

Fail open: any error (stdin that is not a JSON object, a prompt that is not a string, a missing or
broken ``stdlib_reader.py``) prints nothing and exits 0.
"""

from __future__ import annotations

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from stdlib_reader import LazyPattern, secret_shaped
except Exception:  # a partial install: fail open, print nothing
    sys.exit(0)

PROMPT_LIMIT = 1024 * 1024
# The most characters one ``secret_shaped`` call sees: the JWT shape backtracks in time quadratic
# in its text. Windows overlap by more than any shape's shortest match, so a secret across a
# window's edge is whole in the next one.
SHAPE_WINDOW = 1024
SHAPE_OVERLAP = 256
NAME_VALUE_MIN_LINES = 2
NAME_VALUE_LINE = LazyPattern(r"^\s*(?:export\s+)?[A-Z][A-Z0-9_]*=\S")
WARNING = (
    "[hub] This prompt looks like it holds a secret. Put secrets in a git-ignored env file "
    "(for example .env.local, or one listed in hub.json's guard.readable_env_files) and give the "
    "agent the variable name, not the value. The prompt was sent; the secret stays in this "
    "session's transcript."
)


def _shaped(line: str) -> bool:
    step = SHAPE_WINDOW - SHAPE_OVERLAP
    return any(
        secret_shaped(line[start : start + SHAPE_WINDOW])
        for start in range(0, max(len(line) - SHAPE_OVERLAP, 1), step)
    )


def _name_value_block(lines: list[str]) -> bool:
    run = 0
    for line in lines:
        run = run + 1 if NAME_VALUE_LINE.match(line) else 0
        if run >= NAME_VALUE_MIN_LINES:
            return True
    return False


def holds_secret(prompt: str) -> bool:
    lines = prompt[:PROMPT_LIMIT].splitlines()
    return any(_shaped(line) for line in lines) or _name_value_block(lines)


def main() -> int:
    try:
        event = json.loads(sys.stdin.buffer.read())
        prompt = event.get("prompt") if isinstance(event, dict) else None
        if not isinstance(prompt, str) or not holds_secret(prompt):
            return 0
    except Exception:  # fail open: a prompt hook never blocks or garbles a prompt
        return 0
    try:
        sys.stdout.write(json.dumps({"systemMessage": WARNING}) + "\n")
        sys.stdout.flush()
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
