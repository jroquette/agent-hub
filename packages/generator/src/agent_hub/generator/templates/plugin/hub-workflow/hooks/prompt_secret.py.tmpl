#!/usr/bin/env python3
"""UserPromptSubmit: warn when a prompt looks like it holds a secret; never block it.

Input: Claude Code's UserPromptSubmit event on stdin, a JSON object whose ``prompt`` is a string.
Only the prompt's first ``PROMPT_LIMIT`` characters are scanned.

Checks, any one of which is a match:
1. a secret file's name, by the guard's own rule (``guard._secret_tokens``, linear in the text);
2. a secret's shape on a line (``stdlib_reader.secret_shaped``, the shared ``SECRET_SHAPES``);
3. a block of ``NAME_VALUE_MIN_LINES`` or more consecutive ``NAME=value`` lines (``NAME_VALUE_LINE``,
   ``export`` allowed), as pasted from an env file.

Output: on a match, one JSON line ``{"systemMessage": WARNING}`` and exit 0; the warning never
quotes the prompt or the match. No match: no output, exit 0.

Fail open: any error (stdin that is not a JSON object, a prompt that is not a string, a missing or
broken ``guard.py``, ``hubhooks.py`` or ``stdlib_reader.py``, a ``SystemExit`` from the guard's own
import-failure branch) prints nothing and exits 0. The guard is imported inside a function with
``sys.stdout`` swapped for a buffer, so its PreToolUse "ask" line never reaches this event's output.
"""

from __future__ import annotations

import io
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from stdlib_reader import LazyPattern, secret_shaped
except Exception:  # a partial install: fail open, print nothing
    sys.exit(0)

# For a type checker only: annotations are never evaluated here, so the hook does not load typing.
TYPE_CHECKING = False
if TYPE_CHECKING:
    from typing import Callable

PROMPT_LIMIT = 1024 * 1024
NAME_VALUE_MIN_LINES = 2
NAME_VALUE_LINE = LazyPattern(r"^\s*(?:export\s+)?[A-Z][A-Z0-9_]*=\S")
WARNING = (
    "[hub] This prompt looks like it holds a secret. Put secrets in a git-ignored env file "
    "(for example .env.local) and give the agent the variable name, not the value. The prompt was "
    "sent; the secret stays in this session's transcript."
)


def _secret_tokens() -> Callable[[str], list[str]]:
    """The guard's ``_secret_tokens``, imported with stdout swapped, so nothing the guard prints
    (its import-failure "ask" line) gets out."""
    stdout = sys.stdout
    sys.stdout = io.StringIO()
    try:
        import guard
    finally:
        sys.stdout = stdout
    return guard._secret_tokens


def _name_value_block(lines: list[str]) -> bool:
    run = 0
    for line in lines:
        run = run + 1 if NAME_VALUE_LINE.match(line) else 0
        if run >= NAME_VALUE_MIN_LINES:
            return True
    return False


def holds_secret(prompt: str) -> bool:
    text = prompt[:PROMPT_LIMIT]
    if _secret_tokens()(text):
        return True
    lines = text.splitlines()
    return any(secret_shaped(line) for line in lines) or _name_value_block(lines)


def main() -> int:
    try:
        event = json.loads(sys.stdin.buffer.read())
        prompt = event.get("prompt") if isinstance(event, dict) else None
        if not isinstance(prompt, str) or not holds_secret(prompt):
            return 0
    except (Exception, SystemExit):  # fail open: a prompt hook never blocks or garbles a prompt
        return 0
    try:
        sys.stdout.write(json.dumps({"systemMessage": WARNING}) + "\n")
        sys.stdout.flush()
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
