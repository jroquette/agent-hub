#!/usr/bin/env python3
"""UserPromptSubmit: warn when a prompt looks like it holds a secret.

Stub: reads the event from stdin and exits 0 with no output; the secret checks come next.
"""

from __future__ import annotations

import sys


def main() -> int:
    try:
        sys.stdin.buffer.read()
    except Exception:  # fail open: a prompt hook never blocks a prompt
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
