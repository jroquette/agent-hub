# The hub's gate on pull requests and on the default branch: CI runs `make check`, the same
# command as locally. Managed by hub sync.
name: CI

on:
  pull_request:
    branches: ["@@{project_default_branch}"]
  push:
    branches: ["@@{project_default_branch}"]

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      # uv runs the release of agent-hub that hub.json pins (platform.version).
      - uses: astral-sh/setup-uv@v7
        with:
          version: "0.12.19"
      - name: make check
        run: make check
