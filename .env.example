# Copy to .env (git-ignored) to change the Docker setup; `make up` and `docker compose` read it.
# No secrets belong here: the control plane needs none.

# The folder that holds your hubs (and their repos). Mounted read-only at the same path, so a
# hub registered as /home/me/work/acme-hub is found there in the container. `make up` defaults
# it to the folder that holds this repo.
# AGENT_HUB_HUBS_ROOT=/home/me/work

# Host port, published on 127.0.0.1 only. When it is not 7420, point the hooks at it too:
# export AGENT_HUB_WEB_URL=http://127.0.0.1:<port> in the shell that starts Claude Code.
# AGENT_HUB_PORT=7420

# Claude Code's transcripts folder, mounted read-only at the same path (default
# ~/.claude/projects). The container runs as uid 10001: on Linux, give it read access
# (for example `setfacl -R -m u:10001:rX -m d:u:10001:rX ~/.claude/projects`) or the live
# token and cost figures stay empty; hook events arrive either way.
# AGENT_HUB_CLAUDE_PROJECTS=/home/me/.claude/projects

# Build only. A TLS-intercepting proxy's CA bundle for npm and uv during the build (a build
# secret: never stored in the image).
# AGENT_HUB_BUILD_CA=/path/to/ca-bundle.crt

# Build only. 0 builds without git (where Debian's package mirrors are unreachable); Health then
# cannot list the files of hubs that are git repositories.
# AGENT_HUB_INSTALL_GIT=1
